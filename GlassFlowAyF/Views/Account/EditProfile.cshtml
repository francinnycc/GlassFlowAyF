@model GlassFlowAyF.Models.ViewModels.EditProfileViewModel

@{
    ViewData["Title"] = "Editar perfil";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-8 col-md-10">

            <div class="mb-4">

                <h1 class="h3 mb-2">
                    <i class="bi bi-person-gear me-2"></i>
                    Editar perfil
                </h1>

                <p class="text-muted mb-0">
                    Actualiza tu información personal en GlassFlow A&amp;F.
                </p>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Account"
                          asp-action="EditProfile"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-4">

                            <label asp-for="NombreCompleto"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input asp-for="NombreCompleto"
                                       class="form-control"
                                       placeholder="Ingresa tu nombre completo" />

                            </div>

                            <span asp-validation-for="NombreCompleto"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Telefono"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-telephone"></i>
                                </span>

                                <input asp-for="Telefono"
                                       class="form-control"
                                       placeholder="Ejemplo: 8888-8888" />

                            </div>

                            <span asp-validation-for="Telefono"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Direccion"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-geo-alt"></i>
                                </span>

                                <textarea asp-for="Direccion"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Ingresa tu dirección"></textarea>

                            </div>

                            <span asp-validation-for="Direccion"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="alert alert-info">

                            <i class="bi bi-info-circle me-2"></i>

                            El correo electrónico, el rol y la contraseña
                            se administran por separado por motivos de seguridad.

                        </div>


                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar

                            </a>


                            <button type="submit"
                                    class="btn btn-glassflow">

                                <i class="bi bi-check2-circle me-1"></i>
                                Guardar cambios

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}