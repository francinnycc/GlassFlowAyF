@model GlassFlowAyF.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Cambiar contraseña";
}


<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-xl-7 col-lg-8 col-md-10">

            <div class="mb-4">

                <h1 class="h3 mb-2">
                    <i class="bi bi-shield-lock me-2"></i>
                    Cambiar contraseña
                </h1>

                <p class="text-muted mb-0">
                    Actualiza la contraseña utilizada para
                    acceder a tu cuenta de GlassFlow A&amp;F.
                </p>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="alert alert-info mb-4">

                        <i class="bi bi-info-circle me-2"></i>

                        Por seguridad, debes ingresar tu
                        contraseña actual antes de establecer
                        una nueva.

                    </div>


                    <form asp-controller="Account"
                          asp-action="ChangePassword"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <div class="mb-4">

                            <label asp-for="CurrentPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-lock"></i>
                                </span>

                                <input asp-for="CurrentPassword"
                                       class="form-control"
                                       autocomplete="current-password"
                                       placeholder="Ingresa tu contraseña actual" />

                            </div>

                            <span asp-validation-for="CurrentPassword"
                                  class="text-danger small">
                            </span>

                        </div>


                        <hr class="my-4" />


                        <div class="mb-4">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-key"></i>
                                </span>

                                <input asp-for="NewPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Ingresa la nueva contraseña" />

                            </div>

                            <span asp-validation-for="NewPassword"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-check2-circle"></i>
                                </span>

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       autocomplete="new-password"
                                       placeholder="Confirma la nueva contraseña" />

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="alert alert-light border">

                            <strong>
                                Recomendación de seguridad
                            </strong>

                            <div class="small text-muted mt-1">

                                Utiliza una contraseña diferente
                                a la anterior y evita compartirla
                                con otras personas.

                            </div>

                        </div>


                        <div class="d-flex
                            justify-content-end
                            gap-2
                            mt-4">

                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar

                            </a>


                            <button type="submit"
                                    class="btn btn-glassflow">

                                <i class="bi bi-shield-check me-1"></i>
                                Actualizar contraseña

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}