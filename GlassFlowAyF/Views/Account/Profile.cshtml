@model GlassFlowAyF.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Mi perfil";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9 col-md-11">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h1 class="h3 mb-2">
                        <i class="bi bi-person-circle me-2"></i>
                        Mi perfil
                    </h1>

                    <p class="text-muted mb-0">
                        Consulta y administra la información asociada a tu cuenta de GlassFlow A&amp;F.
                    </p>
                </div>

                <a asp-controller="Account"
                   asp-action="EditProfile"
                   class="btn btn-glassflow">

                    <i class="bi bi-pencil-square me-1"></i>
                    Editar perfil

                </a>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-5">

                        <div class="d-inline-flex
                                    align-items-center
                                    justify-content-center
                                    rounded-circle
                                    mb-3"
                             style="
                                width: 80px;
                                height: 80px;
                                background: #e4f8f8;
                                color: #00aeb3;
                                font-size: 2.4rem;">

                            <i class="bi bi-person"></i>

                        </div>

                        <h2 class="h4 mb-1">
                            @Model.NombreCompleto
                        </h2>

                        <span class="badge bg-info text-dark">
                            @Model.Rol
                        </span>

                    </div>


                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-person me-1"></i>
                                    Nombre completo
                                </small>

                                <strong>
                                    @Model.NombreCompleto
                                </strong>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-envelope me-1"></i>
                                    Correo electrónico
                                </small>

                                <strong>
                                    @Model.Email
                                </strong>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-telephone me-1"></i>
                                    Teléfono
                                </small>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.Telefono)
                                        ? "No registrado"
                                        : Model.Telefono)
                                </strong>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-shield-check me-1"></i>
                                    Rol
                                </small>

                                <strong>
                                    @Model.Rol
                                </strong>

                            </div>

                        </div>


                        <div class="col-12">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    Dirección
                                </small>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.Direccion)
                                        ? "No registrada"
                                        : Model.Direccion)
                                </strong>

                            </div>

                        </div>


                        <div class="col-12">

                            <div class="border rounded p-3">

                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    Miembro desde
                                </small>

                                <strong>
                                    @Model.FechaRegistro.ToString("dd/MM/yyyy")
                                </strong>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4" />


                    <div class="d-flex flex-wrap justify-content-between gap-2">

                        <a asp-controller="Home"
                           asp-action="Dashboard"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Volver al inicio

                        </a>


                        <a asp-controller="Account"
                           asp-action="ChangePassword"
                           class="btn btn-outline-dark">

                            <i class="bi bi-shield-lock me-1"></i>
                            Cambiar contraseña

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>