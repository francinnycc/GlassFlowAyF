@{
    ViewData["Title"] = "Contraseña actualizada";
}


<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-xl-6 col-lg-7 col-md-9">

            <div class="card
                border-0
                shadow-sm
                text-center">

                <div class="card-body p-5">

                    <div class="mb-4">

                        <i class="bi bi-shield-check"
                           style="
                            font-size: 4rem;
                            color: #00aeb3;">
                        </i>

                    </div>


                    <h1 class="h3 mb-3">
                        Contraseña actualizada
                    </h1>


                    <p class="text-muted mb-4">

                        Tu contraseña de GlassFlow A&amp;F
                        fue modificada correctamente.

                    </p>


                    <div class="alert alert-success">

                        <i class="bi bi-check-circle me-2"></i>

                        Tu sesión continúa activa y la nueva
                        contraseña ya puede utilizarse para
                        futuros inicios de sesión.

                    </div>


                    <a asp-controller="Home"
                       asp-action="Dashboard"
                       class="btn btn-glassflow mt-3">

                        <i class="bi bi-grid me-1"></i>
                        Volver al inicio

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>