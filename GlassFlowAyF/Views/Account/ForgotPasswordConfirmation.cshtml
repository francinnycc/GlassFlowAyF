@{
    ViewData["Title"] =
        "Solicitud enviada";
}

<div class="auth-page">

    <div class="auth-card text-center">

        <div class="auth-brand">

            <div class="auth-logo">
                GF
            </div>

            <h1>
                GlassFlow A&F
            </h1>

        </div>


        <h2>
            Revisa tu correo
        </h2>


        <p class="text-muted mt-3">

            Si el correo ingresado está
            asociado a una cuenta activa,
            recibirás un enlace para
            restablecer tu contraseña.

        </p>


        <a asp-action="Login"
           class="btn btn-glassflow
            w-100 mt-3">

            Volver a iniciar sesión

        </a>

    </div>

</div>