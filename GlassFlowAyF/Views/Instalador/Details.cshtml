@model GlassFlowAyF.Models.TrabajoInstalacion

@{
    ViewData["Title"] = "Trabajo asignado";

    var solicitud =
        Model.SolicitudCotizacion;
}

<div class="page-header">

    <div>

        <span class="request-id">
            #INS-@(Model.Id.ToString("D5"))
        </span>

        <h1 class="mt-2">
            @Model.Producto
        </h1>

        <p>
            @Model.Cliente
        </p>

    </div>


    <span class="status-badge">
        @Model.Estado
    </span>

</div>


<div class="row g-4">

    <div class="col-lg-7">

        <div class="glass-card mb-4">

            <h4>
                Información del trabajo
            </h4>


            <dl class="row mt-4">

                <dt class="col-sm-4">
                    Cliente
                </dt>

                <dd class="col-sm-8">
                    @Model.Cliente
                </dd>


                <dt class="col-sm-4">
                    Producto
                </dt>

                <dd class="col-sm-8">
                    @Model.Producto
                </dd>


                <dt class="col-sm-4">
                    Dirección
                </dt>

                <dd class="col-sm-8">
                    @Model.Direccion
                </dd>


                <dt class="col-sm-4">
                    Fecha de instalación
                </dt>

                <dd class="col-sm-8">

                    @(Model.FechaInstalacion.ToString(
                        "dd/MM/yyyy hh:mm tt"))

                </dd>


                @if (solicitud != null)
                {
                    <dt class="col-sm-4">
                        Medidas
                    </dt>

                    <dd class="col-sm-8">

                        @if (solicitud.Ancho.HasValue &&
                             solicitud.Alto.HasValue)
                        {
                            <span>
                                @(solicitud.Ancho.Value.ToString("0.00")) m
                                ×
                                @(solicitud.Alto.Value.ToString("0.00")) m
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No registradas
                            </span>
                        }

                    </dd>


                    <dt class="col-sm-4">
                        Material
                    </dt>

                    <dd class="col-sm-8">

                        @(solicitud.Material?.Nombre
                            ?? "No registrado")

                    </dd>


                    <dt class="col-sm-4">
                        Cantidad
                    </dt>

                    <dd class="col-sm-8">
                        @solicitud.Cantidad
                    </dd>


                    <dt class="col-sm-4">
                        Observaciones del proyecto
                    </dt>

                    <dd class="col-sm-8">

                        @(string.IsNullOrWhiteSpace(
                            solicitud.Observaciones)
                            ? "Sin observaciones"
                            : solicitud.Observaciones)

                    </dd>
                }


                @if (!string.IsNullOrWhiteSpace(
                    Model.Observaciones))
                {
                    <dt class="col-sm-4">
                        Observaciones de instalación
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Observaciones
                    </dd>
                }

            </dl>

        </div>


        @if (solicitud?.Fotografias.Any() == true)
        {
            <div class="glass-card">

                <h4>
                    Fotografías del espacio
                </h4>

                <p class="text-muted">
                    Evidencias proporcionadas
                    por el cliente.
                </p>


                <div class="evidence-grid mt-3">

                    @foreach (var foto
                        in solicitud.Fotografias)
                    {
                        <a href="@foto.RutaArchivo"
                               target="_blank"
                               class="evidence-image">

                            <img src="@foto.RutaArchivo"
                                 alt="@foto.NombreOriginal" />

                        </a>
                    }

                </div>

            </div>
        }

    </div>


    <div class="col-lg-5">

        <div class="glass-card">

            <h4>
                Progreso de instalación
            </h4>

            <p class="text-muted">
                Actualiza el checklist conforme
                avances con el trabajo.
            </p>


            <div class="mt-4">

                <div class="checklist-row">

                    <i class="bi
                        @(Model.MedidasConfirmadas
                                                   ? "bi-check-circle-fill text-success"
                                                   : "bi-circle text-muted")">
                    </i>

                    <span>
                        Medidas confirmadas
                    </span>

                </div>


                <div class="checklist-row">

                    <i class="bi
                        @(Model.MaterialListo
                                                   ? "bi-check-circle-fill text-success"
                                                   : "bi-circle text-muted")">
                    </i>

                    <span>
                        Material recibido
                    </span>

                </div>


                <div class="checklist-row">

                    <i class="bi
                        @(Model.InstalacionIniciada
                                                   ? "bi-check-circle-fill text-success"
                                                   : "bi-circle text-muted")">
                    </i>

                    <span>
                        Instalación iniciada
                    </span>

                </div>


                <div class="checklist-row">

                    <i class="bi
                        @(Model.InstalacionRealizada
                                                   ? "bi-check-circle-fill text-success"
                                                   : "bi-circle text-muted")">
                    </i>

                    <span>
                        Instalación realizada
                    </span>

                </div>


                <div class="checklist-row">

                    <i class="bi
                        @(Model.RevisionAcabados
                                                   ? "bi-check-circle-fill text-success"
                                                   : "bi-circle text-muted")">
                    </i>

                    <span>
                        Revisión de acabados
                    </span>

                </div>


                <div class="checklist-row">

                    <i class="bi
                        @(Model.LimpiezaFinal
                                                   ? "bi-check-circle-fill text-success"
                                                   : "bi-circle text-muted")">
                    </i>

                    <span>
                        Limpieza final
                    </span>

                </div>

            </div>


            <a asp-action="Checklist"
                   asp-route-id="@Model.Id"
                   class="btn btn-glassflow w-100 mt-4">

                <i class="bi bi-clipboard-check me-1"></i>

                Abrir checklist

            </a>


            <a asp-action="MiPanel"
                   class="btn btn-outline-secondary w-100 mt-2">

                Volver a mis trabajos

            </a>

        </div>

    </div>

</div>