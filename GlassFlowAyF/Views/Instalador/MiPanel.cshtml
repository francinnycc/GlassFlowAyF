@model IEnumerable<GlassFlowAyF.Models.TrabajoInstalacion>

@{
    ViewData["Title"] = "Mis trabajos";
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            PANEL DEL INSTALADOR
        </span>

        <h1>
            Mis trabajos
        </h1>

        <p>
            Consulta tus instalaciones
            asignadas y registra su progreso.
        </p>

    </div>

</div>


<div class="row g-4 mb-4">

    <div class="col-md-4">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div class="stat-number mt-3">
                @ViewBag.Pendientes
            </div>

            <div class="stat-label">
                Pendientes
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="bi bi-tools"></i>
            </div>

            <div class="stat-number mt-3">
                @ViewBag.EnProceso
            </div>

            <div class="stat-label">
                En proceso
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="stat-number mt-3">
                @ViewBag.Finalizados
            </div>

            <div class="stat-label">
                Finalizados
            </div>

        </div>

    </div>

</div>


@if (!Model.Any())
{
    <div class="glass-card text-center py-5">

        <i class="bi bi-tools fs-1 text-muted"></i>

        <h4 class="mt-3">
            No tienes trabajos asignados
        </h4>

        <p class="text-muted mb-0">
            Cuando el administrador te asigne
            una instalación aparecerá aquí.
        </p>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var trabajo in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="glass-card h-100">

                    <div class="d-flex
                        justify-content-between
                        align-items-start">

                        <span class="request-id">
                            #INS-@(trabajo.Id.ToString("D5"))
                        </span>

                        <span class="status-badge">
                            @trabajo.Estado
                        </span>

                    </div>


                    <h4 class="mt-3 mb-1">
                        @trabajo.Producto
                    </h4>


                    <p class="text-muted">
                        <i class="bi bi-person me-1"></i>
                        @trabajo.Cliente
                    </p>


                    <div class="small mb-2">

                        <i class="bi bi-calendar3 me-1"></i>

                        @(trabajo.FechaInstalacion.ToString(
                            "dd/MM/yyyy hh:mm tt"))

                    </div>


                    <div class="small mb-4">

                        <i class="bi bi-geo-alt me-1"></i>

                        @trabajo.Direccion

                    </div>


                    <a asp-action="Details"
                           asp-route-id="@trabajo.Id"
                           class="btn btn-outline-primary w-100">

                        Ver trabajo

                    </a>

                </div>

            </div>
        }

    </div>
}