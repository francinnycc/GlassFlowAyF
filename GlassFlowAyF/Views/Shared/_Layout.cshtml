<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - GlassFlow A&F
    </title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <header class="topbar">

        <div class="container-fluid px-4">

            <div class="d-flex
                align-items-center
                justify-content-between">

                <a asp-controller="Home"
                       asp-action="Index"
                       class="brand">

                    <div class="brand-icon">
                        GF
                    </div>

                    <div>
                        <strong>GLASSFLOW</strong>
                        <small>A&F</small>
                    </div>

                </a>

                <div class="d-flex
                    align-items-center
                    gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="user-name">
                            <i class="bi bi-person-circle"></i>
                            @User.Identity.Name
                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">

                            <button type="submit"
                                    class="btn btn-outline-light btn-sm">

                                Salir

                            </button>

                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-outline-light btn-sm">

                            Iniciar sesión

                        </a>

                        <a asp-controller="Account"
                               asp-action="Register"
                               class="btn btn-teal btn-sm">

                            Crear cuenta

                        </a>
                    }

                </div>

            </div>

        </div>

    </header>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app-layout">

            <aside class="sidebar">

                <nav>

                    <a asp-controller="Home"
                           asp-action="Dashboard">

                        <i class="bi bi-grid"></i>
                        Inicio

                    </a>

                    <a asp-controller="Productos"
                           asp-action="Index">

                        <i class="bi bi-window"></i>
                        Productos

                    </a>

                    @if (User.IsInRole("Cliente"))
                    {
                        <a asp-controller="Cotizaciones"
                               asp-action="Create">

                            <i class="bi bi-file-earmark-plus"></i>
                            Nueva solicitud

                        </a>

                        <a asp-controller="Cotizaciones"
                               asp-action="MisSolicitudes">

                            <i class="bi bi-clipboard2-check"></i>
                            Mis solicitudes

                        </a>
                    }

                    @if (User.IsInRole("Administrador"))
                    {
                        <div class="sidebar-label">
                            ADMINISTRACIÓN
                        </div>

                        <a asp-controller="Cotizaciones"
                               asp-action="Index">

                            <i class="bi bi-files"></i>
                            Solicitudes

                        </a>

                        <a asp-controller="VisitasTecnicas"
                               asp-action="Index">

                            <i class="bi bi-calendar3"></i>
                            Visitas técnicas

                        </a>

                        <a asp-controller="Instalaciones"
                               asp-action="Index">

                            <i class="bi bi-tools"></i>
                            Instalaciones

                        </a>
                    }

                </nav>

                <div class="sidebar-bottom">

                    <div class="support-card">

                        <i class="bi bi-chat-dots"></i>

                        <strong>¿Necesitas ayuda?</strong>

                        <small>
                            Contacta con soporte GlassFlow.
                        </small>

                    </div>

                </div>

            </aside>

            <main class="main-content">

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Mensaje"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @RenderBody()

            </main>

        </div>
    }
    else
    {
        <main>

            @RenderBody()

        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>