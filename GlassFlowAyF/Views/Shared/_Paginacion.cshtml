@model GlassFlowAyF.ViewModels.PaginacionViewModel
@*
    Paginación reutilizable. Conserva TODOS los filtros de la URL
    (buscar, estado, desde, hasta, técnico, vista...) y solo cambia "pagina".
    Uso: <partial name="_Paginacion" model="(GlassFlowAyF.ViewModels.PaginacionViewModel)ViewBag.Paginacion" />
*@
@{
    string Url(int pagina)
    {
        var partes = Context.Request.Query
            .Where(q => !string.Equals(q.Key, "pagina", StringComparison.OrdinalIgnoreCase))
            .SelectMany(q => q.Value.Select(v => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .ToList();
        partes.Add($"pagina={pagina}");
        return $"{Context.Request.Path}?{string.Join("&", partes)}";
    }

    var primero = Model.TotalRegistros == 0 ? 0 : ((Model.PaginaActual - 1) * Model.RegistrosPorPagina) + 1;
    var ultimo = Math.Min(Model.PaginaActual * Model.RegistrosPorPagina, Model.TotalRegistros);
    var desde = Math.Max(1, Model.PaginaActual - 2);
    var hasta = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);
}

@if (Model.TotalRegistros > 0)
{
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <small class="text-muted">Mostrando @primero–@ultimo de @Model.TotalRegistros registros</small>

        @if (Model.TotalPaginas > 1)
        {
            <nav aria-label="Paginación">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.TieneAnterior ? "" : "disabled")">
                        <a class="page-link" href="@Url(Model.PaginaActual - 1)">Anterior</a>
                    </li>

                    @if (desde > 1)
                    {
                        <li class="page-item"><a class="page-link" href="@Url(1)">1</a></li>
                        @if (desde > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                    }

                    @for (var i = desde; i <= hasta; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" href="@Url(i)">@i</a>
                        </li>
                    }

                    @if (hasta < Model.TotalPaginas)
                    {
                        @if (hasta < Model.TotalPaginas - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                        <li class="page-item"><a class="page-link" href="@Url(Model.TotalPaginas)">@Model.TotalPaginas</a></li>
                    }

                    <li class="page-item @(Model.TieneSiguiente ? "" : "disabled")">
                        <a class="page-link" href="@Url(Model.PaginaActual + 1)">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
