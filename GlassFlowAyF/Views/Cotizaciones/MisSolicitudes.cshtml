@model IEnumerable<GlassFlowAyF.Models.SolicitudCotizacion>

@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="page-header">

    <div>
        <h1>Mis solicitudes</h1>
        <p>
            Consulta el avance de tus proyectos.
        </p>
    </div>

    <a class="btn btn-glassflow"
           asp-action="Create">

        Nueva solicitud

    </a>

</div>

<div class="row g-4">

    @foreach (var item in Model)
    {
        <div class="col-md-6 col-xl-4">

            <div class="glass-card h-100">

                <div class="d-flex
                    justify-content-between
                    align-items-start">

                    <span class="request-id">
                        #SOL-@item.Id.ToString("D5")
                    </span>

                    <span class="status-badge">
                        @item.Estado
                    </span>

                </div>

                <h4 class="mt-3">
                    @item.TipoProducto
                </h4>

                <p class="text-muted">
                    @item.Descripcion
                </p>

                <div class="small mb-3">

                    <strong>Fecha:</strong>

                    @item.FechaSolicitud
                    .ToString("dd/MM/yyyy")

                </div>

                <a class="btn btn-outline-primary w-100"
                       asp-action="Details"
                       asp-route-id="@item.Id">

                    Ver seguimiento

                </a>

            </div>

        </div>
    }

</div>