@model IEnumerable<GlassFlowAyF.Models.SolicitudCotizacion>

@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="page-header">

    <div>

        <h1>
            Mis solicitudes
        </h1>

        <p>
            Consulta el avance de tus proyectos.
        </p>

    </div>

    <a class="btn btn-glassflow"
       asp-action="Create">

        <i class="bi bi-plus-lg me-1"></i>
        Nueva solicitud

    </a>

</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">

        <i class="bi bi-clipboard fs-1 text-muted">
        </i>

        <h4 class="mt-3">
            Aún no tienes solicitudes
        </h4>

        <p class="text-muted">
            Empieza configurando tu primer proyecto.
        </p>

        <a asp-action="Create"
           class="btn btn-glassflow">

            <i class="bi bi-plus-lg me-1"></i>
            Crear solicitud

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="glass-card h-100">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <span class="request-id">

                            #SOL-@item.Id.ToString("D5")

                        </span>

                        <span class="status-badge">

                            @item.Estado

                        </span>

                    </div>

                    <h4 class="mt-3">

                        @(item.Producto?.Nombre
                            ?? item.TipoProducto
                            ?? "Solicitud sin producto")

                    </h4>

                    @if (item.Material != null)
                    {
                        <div class="small text-muted mb-2">

                            <i class="bi bi-layers me-1"></i>

                            @item.Material.Nombre

                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(
                        item.Descripcion))
                    {
                        <p class="text-muted">

                            @item.Descripcion

                        </p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">

                            Borrador pendiente de completar.

                        </p>
                    }

                    <div class="small mb-3">

                        <strong>Fecha:</strong>

                        @item.FechaSolicitud.ToString("dd/MM/yyyy")

                    </div>

                    <div class="d-grid gap-2">

                        <a class="btn btn-outline-primary"
                           asp-action="Details"
                           asp-route-id="@item.Id">

                            <i class="bi bi-eye me-1"></i>
                            Ver seguimiento

                        </a>

                        @if (item.Estado == "Borrador" ||
                             item.Estado == "Solicitado")
                        {
                            <a class="btn btn-outline-secondary"
                               asp-action="Edit"
                               asp-route-id="@item.Id">

                                <i class="bi bi-pencil-square me-1"></i>
                                Editar solicitud

                            </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>
}