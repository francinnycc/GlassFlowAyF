@model GlassFlowAyF.Models.SolicitudCotizacion
@{ var ultima = Model.ValidacionesTecnicas.OrderByDescending(v => v.Id).FirstOrDefault(); }
<section class="glass-card mb-4">
    <h3>Validación técnica</h3>
    @if (ultima == null) { <p>Sin validación técnica registrada.</p> }
    else
    {
        <p><strong>@ultima.Resultado</strong> · Complejidad @ultima.Complejidad</p>
        @if (ultima.RecomiendaVisita)
        {
            <div class="alert alert-info">Después de revisar la solicitud, se recomienda una visita técnica.</div>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-controller="VisitasTecnicas" asp-action="Create" asp-route-solicitudId="@Model.Id" class="btn btn-outline-primary mb-3">Programar visita recomendada</a>
            }
        }
    }
    @if (User.IsInRole("Administrador") && Model.Estado != "Borrador" && !Model.Cotizaciones.Any(c => c.Estado == "Aprobada"))
    {
        <form asp-controller="ValidacionesTecnicas" asp-action="Registrar" method="post">
            <input type="hidden" name="solicitudId" value="@Model.Id" />
            <div class="row g-3">
                <div class="col-md-6"><label for="resultado" class="form-label">Resultado de la revisión</label>
                    <select id="resultado" name="Resultado" class="form-select"><option>Validada</option><option>Pendiente de información</option></select></div>
                <div class="col-md-6"><label for="complejidad" class="form-label">Complejidad</label>
                    <select id="complejidad" name="Complejidad" class="form-select"><option>Baja</option><option>Media</option><option>Alta</option></select></div>
                <div class="col-12"><label for="revision" class="form-label">Información revisada y observaciones técnicas</label>
                    <textarea id="revision" name="Observaciones" maxlength="1500" required class="form-control" rows="3"></textarea></div>
                <div class="col-12"><label for="informacion" class="form-label">Información adicional que debe aportar el cliente</label>
                    <textarea id="informacion" name="InformacionSolicitada" maxlength="1500" class="form-control" rows="2"></textarea></div>
                <div class="col-12"><label><input name="RecomiendaVisita" type="checkbox" value="true" /> Recomendar visita técnica</label></div>
            </div>
            <button class="btn btn-glassflow mt-3" type="submit">Registrar validación</button>
        </form>
    }
    <h4 class="mt-4">Historial de validaciones</h4>
    @foreach (var item in Model.ValidacionesTecnicas.OrderByDescending(v => v.Id))
    {
        <article class="border rounded p-3 mb-3">
            <p><strong>@item.Resultado · @item.Complejidad</strong><br />@item.Fecha.ToString("dd/MM/yyyy HH:mm") · @item.Autor</p>
            <p style="white-space:pre-wrap">@item.Observaciones</p>
            <p>Visita recomendada: @(item.RecomiendaVisita ? "Sí" : "No")</p>
            @if (item.InformacionSolicitada != null)
            {
                <p><strong>Información solicitada:</strong></p><p style="white-space:pre-wrap">@item.InformacionSolicitada</p>
                @if (item.FechaRespuesta != null)
                {
                    <p><strong>Respuesta del cliente · @item.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm")</strong></p>
                    <p style="white-space:pre-wrap">@item.RespuestaCliente</p>
                }
                else if (User.IsInRole("Cliente"))
                {
                    <form asp-controller="ValidacionesTecnicas" asp-action="Responder" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <label for="respuesta-@item.Id">Respuesta / enlace a fotografías adicionales</label>
                        <textarea id="respuesta-@item.Id" name="respuesta" class="form-control mb-2" rows="3" maxlength="2000" required></textarea>
                        <button type="submit" class="btn btn-glassflow">Enviar información</button>
                    </form>
                }
                else { <p class="text-muted">Pendiente de respuesta del cliente.</p> }
            }
        </article>
    }
</section>
