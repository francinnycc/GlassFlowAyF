@model IEnumerable<GlassFlowAyF.Models.HistorialMedida>

@{
    ViewData["Title"] = "Historial de medidas";

    var solicitud = ViewBag.Solicitud
        as GlassFlowAyF.Models.SolicitudCotizacion;

    var historial = Model?
        .OrderByDescending(h => h.FechaRegistro)
        .ThenByDescending(h => h.Id)
        .ToList() ?? new List<GlassFlowAyF.Models.HistorialMedida>();
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <span class="request-id">
            #SOL-@(solicitud?.Id.ToString("D5") ?? "00000")
        </span>

        <h1 class="mb-1">Historial de medidas</h1>

        <p class="text-muted mb-0">
            Consulte las medidas registradas durante el proceso
            de la solicitud.
        </p>
    </div>

    <div>
        <a asp-controller="Cotizaciones"
           asp-action="Details"
           asp-route-id="@solicitud?.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a solicitud
        </a>
    </div>
</div>

<div class="glass-card mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1">
                <i class="bi bi-rulers me-2"></i>
                Registros de medidas
            </h3>

            <p class="text-muted mb-0">
                Historial ordenado del más reciente al más antiguo.
            </p>
        </div>

        <span class="badge bg-primary">
            @historial.Count registros
        </span>
    </div>

    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        El historial conserva los valores registrados,
        pero no almacena la unidad utilizada en cada registro.
        Verifique la unidad antes de comparar medidas históricas.
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Ancho</th>
                    <th>Alto</th>
                    <th>Profundidad</th>
                    <th>Cantidad</th>
                    <th>Usuario</th>
                    <th>Observaciones</th>
                </tr>
            </thead>

            <tbody>
                @if (historial.Any())
                {
                    foreach (var item in historial)
                    {
                        <tr>
                            <td>
                                @item.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")
                            </td>

                            <td>
                                @(item.Ancho.HasValue
                                    ? item.Ancho.Value.ToString("N2")
                                    : "No registrada")
                            </td>

                            <td>
                                @(item.Alto.HasValue
                                    ? item.Alto.Value.ToString("N2")
                                    : "No registrada")
                            </td>

                            <td>
                                @(item.Profundidad.HasValue
                                    ? item.Profundidad.Value.ToString("N2")
                                    : "No registrada")
                            </td>

                            <td>@item.Cantidad</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.UsuarioRegistro)
                                    ? "No identificado"
                                    : item.UsuarioRegistro)
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                {
                                    <span style="white-space:pre-wrap">@item.Observaciones</span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin observaciones
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-5">
                            <i class="bi bi-clipboard-x fs-3 d-block mb-2"></i>
                            No existen registros de medidas
                            para esta solicitud.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
