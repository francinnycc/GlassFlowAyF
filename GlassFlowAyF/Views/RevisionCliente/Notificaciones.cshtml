@model List<GlassFlowAyF.Models.Notificacion>
@{
    ViewData["Title"] = "Notificaciones";
    var todas = (bool)ViewBag.Todas;
}

<div class="page-header">
    <div>
        <span class="eyebrow">EQUIPO</span>
        <h1>Notificaciones internas</h1>
        <p>Avisos y tareas para administración, cotización y operaciones.</p>
    </div>
    <a asp-action="Notificaciones" asp-route-todas="@(!todas)" class="btn btn-outline-secondary">
        @(todas ? "Ver solo no leídas" : "Ver todas")
    </a>
</div>

<div class="glass-card">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">No hay notificaciones.</p>
    }
    <ul class="list-group list-group-flush">
        @foreach (var n in Model)
        {
            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-start gap-3 @(n.Leida ? "opacity-50" : "")">
                <div>
                    <span class="badge @(n.Tipo == "Tarea" ? "text-bg-warning" : "text-bg-info") me-1">@n.Tipo</span>
                    <span class="badge text-bg-light border me-1">@n.DestinatarioRol</span>
                    <strong>@n.Titulo</strong>
                    <div class="small text-muted">@n.Mensaje</div>
                    <div class="small text-muted">@n.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrEmpty(n.Url) && n.Url.StartsWith("/"))
                    {
                        <a href="@n.Url" class="btn btn-sm btn-outline-primary">Abrir</a>
                    }
                    @if (!n.Leida)
                    {
                        <form asp-action="MarcarLeida" asp-route-id="@n.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Marcar leída</button>
                        </form>
                    }
                </div>
            </li>
        }
    </ul>
</div>
