@model GlassFlowAyF.Models.ViewModels.RevisionPropuestaViewModel
@{
    var s = Model.Solicitud;
    var c = Model.Cotizacion!;
    var m = s.Material;
}

<div class="row g-4">
    <div class="col-md-6">
        <h6><i class="bi bi-square me-1"></i>Ficha técnica – Vidrio / material</h6>
        <table class="table table-sm small">
            <tbody>
                <tr><th>Material</th><td>@(m?.Nombre ?? "Por definir")</td></tr>
                <tr><th>Tipo</th><td>@(m?.Tipo ?? "-")</td></tr>
                <tr><th>Grosor</th><td>@(m?.Grosor != null ? $"{m.Grosor} mm" : "-")</td></tr>
                <tr><th>Descripción</th><td>@(m?.Descripcion ?? "-")</td></tr>
            </tbody>
        </table>

        <h6><i class="bi bi-bounding-box me-1"></i>Perfilería</h6>
        <table class="table table-sm small">
            <tbody>
                <tr><th>Perfil</th><td>@(m?.Perfil ?? "-")</td></tr>
                <tr><th>Color</th><td>@(m?.Color ?? Model.Diseno?.ColorPerfil ?? "-")</td></tr>
                <tr><th>Acabado</th><td>@(m?.Acabado ?? "-")</td></tr>
            </tbody>
        </table>

        <h6><i class="bi bi-tools me-1"></i>Herrajes y sistema</h6>
        <p class="small text-muted" style="white-space:pre-line">@(s.Producto?.Descripcion ?? "Según el sistema del producto seleccionado.")
@c.DetalleTecnico</p>
    </div>

    <div class="col-md-6">
        <h6><i class="bi bi-shield-check me-1"></i>Garantías aplicables</h6>
        <ul class="small text-muted">
            <li>Garantía de fabricación sobre materiales y perfilería según el proveedor.</li>
            <li>Garantía de instalación por defectos de mano de obra.</li>
            <li>Las garantías no cubren golpes, uso indebido ni modificaciones de terceros.</li>
        </ul>

        <h6><i class="bi bi-file-earmark-text me-1"></i>Condiciones comerciales</h6>
        <p class="small text-muted" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(c.Condiciones) ? "Sin condiciones adicionales." : c.Condiciones)</p>
        <p class="small"><strong>Vigencia:</strong> hasta @c.FechaVencimiento.ToString("dd/MM/yyyy") · <strong>Total:</strong> ₡@c.Total.ToString("N2")</p>

        @if (Model.Diseno?.Recomendacion is { Length: > 0 } recomendacion)
        {
            <h6><i class="bi bi-lightbulb me-1"></i>Recomendación de diseño</h6>
            <p class="small text-muted" style="white-space:pre-line">@recomendacion</p>
        }
    </div>
</div>

<h6 class="mt-3"><i class="bi bi-images me-1"></i>Planos y renders adjuntos</h6>
<div class="row g-2">
    @foreach (var diseno in s.DisenosIA.Where(x => !string.IsNullOrWhiteSpace(x.RutaImagenGenerada)))
    {
        <div class="col-6 col-md-3">
            <a href="@diseno.RutaImagenGenerada" target="_blank" rel="noopener">
                <img src="@diseno.RutaImagenGenerada" class="img-fluid rounded border @(diseno.Id == Model.Diseno?.Id ? "border-primary border-3" : "")" alt="Render @diseno.Estilo" />
            </a>
        </div>
    }
    @foreach (var foto in s.Fotografias)
    {
        <div class="col-6 col-md-3">
            <a href="@foto.RutaArchivo" target="_blank" rel="noopener">
                <img src="@foto.RutaArchivo" class="img-fluid rounded border" alt="Fotografía del sitio" />
            </a>
        </div>
    }
    @if (!s.DisenosIA.Any() && !s.Fotografias.Any())
    {
        <p class="small text-muted">No hay planos ni renders adjuntos.</p>
    }
</div>
