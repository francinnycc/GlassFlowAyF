@model GlassFlowAyF.Models.Material

@{
    ViewData["Title"] = "Nuevo material";
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            MATERIALES
        </span>

        <h1>
            Nuevo material
        </h1>

        <p>
            Registra vidrio, color,
            perfil y acabado.
        </p>

    </div>

</div>


<form asp-action="Create"
      method="post"
      class="glass-card">

    <partial name="_MaterialForm"
             model="Model" />

    <div class="d-flex gap-2 mt-4">

        <button type="submit"
                class="btn btn-glassflow">

            Guardar

        </button>

        <a asp-action="Index"
               class="btn btn-outline-secondary">

            Cancelar

        </a>

    </div>

</form>