@model GlassFlowAyF.Models.Material

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>


<div class="row g-4">

    <div class="col-md-6">

        <label asp-for="Nombre"
               class="form-label">
        </label>

        <input asp-for="Nombre"
               class="form-control" />

        <span asp-validation-for="Nombre"
              class="text-danger">
        </span>

    </div>


    <div class="col-md-6">

        <label asp-for="Tipo"
               class="form-label">
        </label>

        <select asp-for="Tipo"
                class="form-select">

            <option value="">
                Seleccione...
            </option>

            <option>Vidrio templado</option>
            <option>Vidrio laminado</option>
            <option>Vidrio flotado</option>
            <option>Aluminio</option>
            <option>Espejo</option>
            <option>Otro</option>

        </select>

    </div>


    <div class="col-md-6">

        <label asp-for="Color"
               class="form-label">
        </label>

        <input asp-for="Color"
               class="form-control" />

    </div>


    <div class="col-md-6">

        <label asp-for="Perfil"
               class="form-label">
        </label>

        <input asp-for="Perfil"
               class="form-control" />

    </div>


    <div class="col-md-4">

        <label asp-for="Acabado"
               class="form-label">
        </label>

        <input asp-for="Acabado"
               class="form-control" />

    </div>


    <div class="col-md-4">

        <label asp-for="Grosor"
               class="form-label">
        </label>

        <input asp-for="Grosor"
               class="form-control" />

    </div>


    <div class="col-md-4">

        <label asp-for="PrecioAdicional"
               class="form-label">
        </label>

        <input asp-for="PrecioAdicional"
               class="form-control" />

    </div>


    <div class="col-12">

        <label asp-for="Descripcion"
               class="form-label">
        </label>

        <textarea asp-for="Descripcion"
                  class="form-control"
                      rows="3">
        </textarea>

        </div>

    </div>