@model IEnumerable<GlassFlowAyF.Models.DisenoIA>

@{
    ViewData["Title"] = "Mis diseños IA";
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            GLASSFLOW AI STUDIO
        </span>

        <h1>
            Mis diseños
        </h1>

        <p>
            Consulta las propuestas visuales
            generadas para tus proyectos.
        </p>

    </div>


    <a asp-action="Index"
           class="btn btn-glassflow">

        <i class="bi bi-stars me-1"></i>

        Crear nuevo diseño

    </a>

</div>


@if (!Model.Any())
{
    <div class="glass-card text-center py-5">

        <i class="bi bi-images fs-1 text-muted"></i>

        <h4 class="mt-3">
            Aún no tienes diseños
        </h4>

        <p class="text-muted">
            Selecciona una solicitud y genera
            tu primera propuesta visual.
        </p>

        <a asp-action="Index"
               class="btn btn-glassflow">

            Comenzar

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var diseno in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="ai-design-card h-100">

                    <div class="ai-design-image">

                        @if (!string.IsNullOrWhiteSpace(
                            diseno.RutaImagenGenerada))
                        {
                            <img src="@diseno.RutaImagenGenerada"
                                 alt="Diseño generado con IA" />
                        }
                        else
                        {
                            <div class="ai-project-placeholder">

                                <i class="bi bi-image"></i>

                            </div>
                        }


                        @if (diseno.EsFavorito)
                        {
                            <span class="ai-favorite-badge">

                                <i class="bi bi-heart-fill"></i>

                                Preferido

                            </span>
                        }

                    </div>


                    <div class="p-4">

                        <span class="request-id">
                            #SOL-@(diseno.SolicitudCotizacionId.ToString("D5"))
                        </span>


                        <h4 class="mt-2">

                            @(diseno.SolicitudCotizacion?
                                .Producto?.Nombre
                                ?? diseno.SolicitudCotizacion?
                                    .TipoProducto
                                ?? "Proyecto GlassFlow")

                        </h4>


                        <div class="ai-tags mb-3">

                            <span>
                                @diseno.Estilo
                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                diseno.ColorPerfil))
                            {
                                <span>
                                    @diseno.ColorPerfil
                                </span>
                            }

                        </div>


                        <p class="small text-muted">

                            <i class="bi bi-calendar3 me-1"></i>

                            @(diseno.FechaGeneracion.ToString(
                                "dd/MM/yyyy hh:mm tt"))

                        </p>


                        <div class="d-flex gap-2">

                            <a asp-action="Resultado"
                                   asp-route-id="@diseno.Id"
                                   class="btn btn-outline-primary flex-fill">

                                Ver diseño

                            </a>


                            @if (!diseno.EsFavorito)
                            {
                                <form asp-action="Eliminar"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@diseno.Id" />

                                    <button type="submit"
                                            class="btn btn-outline-danger"
                                            onclick="return confirm('¿Eliminar este diseño?');">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}