@model IEnumerable<GlassFlowAyF.Models.SolicitudCotizacion>

@{
    ViewData["Title"] =
        "Recomendaciones IA";
}


<div class="page-header">

    <div>

        <span class="eyebrow">
            GLASSFLOW AI STUDIO
        </span>

        <h1>
            Recomendaciones y diseños con IA
        </h1>

        <p>
            Convierte la información de tus proyectos
            en conceptos visuales y recomendaciones
            personalizadas.
        </p>

    </div>


    <a asp-action="MisDisenos"
           class="btn btn-outline-primary">

        <i class="bi bi-images me-1">
        </i>

        Mis diseños

    </a>

</div>


<div class="ai-info-banner mb-4">

    <div class="ai-info-icon">

        <i class="bi bi-stars">
        </i>

    </div>


    <div>

        <strong>
            Propuestas conceptuales asistidas por IA
        </strong>

        <p class="mb-0">

            GlassFlow utiliza los datos y fotografías
            de tu solicitud para crear inspiración visual.

            Las medidas, fijaciones, espesores y
            condiciones de seguridad siempre deben
            ser validadas por un técnico.

        </p>

    </div>

</div>


@if (!Model.Any())
{
    <div class="glass-card text-center py-5">

        <i class="bi bi-stars fs-1 text-muted">
        </i>

        <h4 class="mt-3">
            Primero crea una solicitud
        </h4>

        <p class="text-muted">

            Necesitamos conocer el producto,
            materiales y medidas de tu proyecto.

        </p>

        <a asp-controller="Cotizaciones"
               asp-action="Create"
               class="btn btn-glassflow">

            Crear solicitud

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var solicitud in Model)
        {
            var favorito =
                solicitud.DisenosIA
                    .FirstOrDefault(
                        d =>
                            d.EsFavorito);


            <div class="col-md-6 col-xl-4">

                <div class="ai-project-card h-100">


                    <div class="ai-project-cover">


                        @if (favorito != null &&
                            !string.IsNullOrWhiteSpace(
                                favorito.RutaImagenGenerada))
                        {
                            <img src="@favorito.RutaImagenGenerada"
                                 alt="Diseño IA preferido" />


                            <span class="ai-favorite-badge">

                                <i class="bi bi-heart-fill">
                                </i>

                                Preferido

                            </span>
                        }
                        else if (solicitud.Fotografias.Any())
                        {
                            <img src="@solicitud.Fotografias.First().RutaArchivo"
                                 alt="Fotografía del espacio" />
                        }
                        else
                        {
                            <div class="ai-project-placeholder">

                                <i class="bi bi-stars">
                                </i>

                            </div>
                        }


                    </div>


                    <div class="p-4">


                        <div class="d-flex
                            justify-content-between
                            align-items-start
                            gap-3">


                            <span class="request-id">

                                #SOL-@solicitud.Id.ToString("D5")

                            </span>


                            <span class="small text-muted">

                                @solicitud.DisenosIA.Count diseño(s)

                            </span>


                        </div>


                        <h4 class="mt-3">

                            @(solicitud.Producto?.Nombre
                                ?? solicitud.TipoProducto)

                        </h4>


                        <p class="text-muted mb-2">

                            <i class="bi bi-layers me-1">
                            </i>

                            @(solicitud.Material?.Nombre
                                ?? "Material por definir")

                        </p>


                        <p class="small text-muted">


                            @if (solicitud.Ancho.HasValue &&
                                 solicitud.Alto.HasValue)
                            {
                                <span>

                                    @solicitud.Ancho.Value.ToString("0.00") m
                                    ×
                                    @solicitud.Alto.Value.ToString("0.00") m

                                </span>
                            }


                        </p>


                        <a asp-action="Generar"
                               asp-route-solicitudId="@solicitud.Id"
                               class="btn btn-glassflow w-100 mt-2">

                            <i class="bi bi-magic me-1">
                            </i>

                            Crear propuesta con IA

                        </a>


                    </div>


                </div>

            </div>
        }

    </div>
}