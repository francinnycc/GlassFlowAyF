@model GlassFlowAyF.Models.DisenoIA

@{
    ViewData["Title"] = "Resultado IA";
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            DISEÑO GENERADO CON IA
        </span>

        <h1>
            Tu propuesta GlassFlow
        </h1>

        <p>
            Explora el concepto visual y
            las recomendaciones para tu proyecto.
        </p>

    </div>


    <div class="d-flex gap-2">

        @if (User.IsInRole("Cliente"))
        {
            <a asp-action="Generar"
               asp-route-solicitudId="@Model.SolicitudCotizacionId"
               class="btn btn-outline-primary">

                <i class="bi bi-arrow-repeat me-1"></i>

                Generar otra

            </a>
        }


        <a asp-action="@(User.IsInRole("Cliente")
                                                                         ? "MisDisenos"
                                                                         : "Administrar")"
           class="btn btn-outline-secondary">

            Volver

        </a>

    </div>

</div>


<div class="row g-4">

    <div class="col-lg-7">

        <div class="ai-result-image-card">

            @if (!string.IsNullOrWhiteSpace(
                Model.RutaImagenGenerada))
            {
                <img src="@Model.RutaImagenGenerada"
                     alt="Diseño conceptual generado con IA" />
            }
            else
            {
                <div class="ai-project-placeholder">

                    <i class="bi bi-image"></i>

                </div>
            }


            <div class="ai-generated-label">

                <i class="bi bi-stars"></i>

                Concepto generado con IA

            </div>

        </div>


        @if (Model.FotografiaBase != null)
        {
            <div class="glass-card mt-4">

                <h5>
                    Fotografía original utilizada
                </h5>

                <a href="@Model.FotografiaBase.RutaArchivo"
                   target="_blank">

                    <img src="@Model.FotografiaBase.RutaArchivo"
                         class="ai-original-photo mt-3"
                         alt="Fotografía original" />

                </a>

            </div>
        }

    </div>


    <div class="col-lg-5">

        <div class="glass-card mb-4">

            <div class="d-flex
                justify-content-between
                align-items-start">

                <div>

                    <span class="request-id">
                        #SOL-@(Model.SolicitudCotizacionId.ToString("D5"))
                    </span>

                    <h4 class="mt-2">

                        @(Model.SolicitudCotizacion?
                            .Producto?.Nombre
                            ?? Model.SolicitudCotizacion?
                                .TipoProducto
                            ?? "Proyecto GlassFlow")

                    </h4>

                </div>


                @if (Model.EsFavorito)
                {
                    <span class="ai-favorite-badge static">

                        <i class="bi bi-heart-fill"></i>

                        Preferido

                    </span>
                }

            </div>


            <div class="ai-tags mt-3">

                <span>
                    @Model.Estilo
                </span>


                @if (!string.IsNullOrWhiteSpace(
                    Model.ColorPerfil))
                {
                    <span>
                        @Model.ColorPerfil
                    </span>
                }


                @if (!string.IsNullOrWhiteSpace(
                    Model.Ambiente))
                {
                    <span>
                        @Model.Ambiente
                    </span>
                }

            </div>


            <p class="small text-muted mt-3 mb-0">

                Generado el
                @(Model.FechaGeneracion.ToString(
                    "dd/MM/yyyy hh:mm tt"))

            </p>

        </div>


        <div class="glass-card mb-4">

            <div class="d-flex
                align-items-center
                gap-2
                mb-3">

                <div class="stat-icon">
                    <i class="bi bi-lightbulb"></i>
                </div>

                <div>

                    <span class="eyebrow">
                        RECOMENDACIÓN
                    </span>

                    <h4 class="mb-0">
                        Análisis de diseño
                    </h4>

                </div>

            </div>


            <div class="ai-recommendation-text">
                @Model.Recomendacion
            </div>

        </div>


        <div class="ai-technical-warning mb-4">

            <i class="bi bi-shield-exclamation"></i>

            <div>

                <strong>
                    Propuesta conceptual
                </strong>

                <p class="mb-0">

                    Este resultado sirve como referencia visual.
                    Las medidas, espesores, soportes,
                    fijaciones y condiciones de seguridad
                    deben confirmarse técnicamente antes
                    de fabricar o instalar.

                </p>

            </div>

        </div>


        <div class="glass-card mb-3">
            <h5>Revisión formal de la propuesta</h5>
            <p class="mb-2"><strong>Estado:</strong> @Model.EstadoRevision</p>
            @if (!string.IsNullOrWhiteSpace(Model.ComentarioRevision))
            {
                <p class="text-muted">Último comentario: @Model.ComentarioRevision</p>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @if (User.IsInRole("Cliente") && Model.EstadoRevision != "Aprobado" && Model.EstadoRevision != "Rechazado")
            {
                <form asp-action="ResponderDiseno" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="comentarioRevision" class="form-label">Comentario o modificaciones solicitadas</label>
                    <textarea id="comentarioRevision" name="comentario" maxlength="2000" rows="3" class="form-control mb-2" placeholder="Explicá qué querés cambiar o por qué rechazás la propuesta"></textarea>
                    <div class="d-grid gap-2">
                        <button name="decision" value="aprobar" type="submit" class="btn btn-success">Aprobar propuesta</button>
                        <button name="decision" value="cambios" type="submit" class="btn btn-outline-primary">Solicitar modificaciones</button>
                        <button name="decision" value="rechazar" type="submit" class="btn btn-outline-danger">Rechazar propuesta</button>
                    </div>
                </form>
            }
            <h6 class="mt-3">Historial de respuestas</h6>
            @if (Model.Revisiones?.Any() == true)
            {
                @foreach (var revision in Model.Revisiones.OrderByDescending(r => r.Fecha))
                {
                    <div class="border-top py-2">
                        <strong>@revision.Estado</strong> · @revision.Fecha.ToString("dd/MM/yyyy HH:mm")
                        @if (!string.IsNullOrWhiteSpace(revision.Comentario))
                        {
                            <p class="mb-0">@revision.Comentario</p>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">Todavía no hay respuestas registradas.</p>
            }
        </div>

        @if (User.IsInRole("Cliente"))
        {
            @if (!Model.EsFavorito && string.Equals(Model.EstadoRevision, "Aprobado", StringComparison.OrdinalIgnoreCase))
            {
                <form asp-action="SeleccionarFavorito"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-glassflow w-100 mb-2">

                        <i class="bi bi-heart me-1"></i>

                        Elegir como diseño preferido

                    </button>

                </form>
            }


            @if (!Model.EsFavorito && !string.Equals(Model.EstadoRevision, "Aprobado", StringComparison.OrdinalIgnoreCase))
            {
                <p class="text-muted small">Podrás marcar este diseño como preferido cuando esté aprobado.</p>
            }

            <a asp-controller="Cotizaciones"
               asp-action="Details"
               asp-route-id="@Model.SolicitudCotizacionId"
               class="btn btn-outline-primary w-100">

                Ver solicitud relacionada

            </a>
        }
        else
        {
            <a asp-controller="Cotizaciones"
               asp-action="Details"
               asp-route-id="@Model.SolicitudCotizacionId"
               class="btn btn-glassflow w-100">

                Abrir solicitud del cliente

            </a>
        }

    </div>
</div>