@model GlassFlowAyF.Models.TrabajoInstalacion

@{
    ViewData["Title"] = "Asignar instalación";
}

<div class="page-header">

    <div>

        <h1>
            Asignación de instalador
        </h1>

        <p>
            Selecciona una compra pagada
            y el instalador responsable.
        </p>

    </div>

</div>


<form asp-action="Create"
      method="post"
      class="glass-card">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <div class="row g-4">

        <div class="col-12">

            <label asp-for="CompraId"
                   class="form-label">

                Orden / Compra

            </label>

            <select asp-for="CompraId"
                    asp-items="ViewBag.Compras"
                    class="form-select">

                <option value="">
                    Seleccione...
                </option>

            </select>

        </div>


        <div class="col-md-6">

            <label asp-for="FechaInstalacion"
                   class="form-label">
            </label>

            <input asp-for="FechaInstalacion"
                   type="datetime-local"
                   class="form-control" />

        </div>


        <div class="col-md-6">

            <label asp-for="InstaladorId"
                   class="form-label">

                Instalador

            </label>

            <select asp-for="InstaladorId"
                    asp-items="ViewBag.Instaladores"
                    class="form-select">

                <option value="">
                    Seleccione un instalador...
                </option>

            </select>

        </div>


        <div class="col-12">

            <label asp-for="Observaciones"
                   class="form-label">
            </label>

            <textarea asp-for="Observaciones"
                      class="form-control"
                          rows="4">
            </textarea>

            </div>

        </div>


        <button class="btn btn-glassflow mt-4">

            Guardar asignación

        </button>

    </form>