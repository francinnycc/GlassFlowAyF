@model IEnumerable<GlassFlowAyF.Models.TrabajoInstalacion>

@{
    ViewData["Title"] = "Instalaciones";
}

<div class="page-header">

    <div>
        <h1>Panel de instalaciones</h1>

        <p>
            Consulta trabajos,
            instaladores y avances.
        </p>
    </div>

    <a class="btn btn-glassflow"
       asp-action="Create">

        Asignar instalación

    </a>

</div>

<div class="row g-4">

    @foreach (var item in Model)
    {
        <div class="col-md-6 col-xl-4">

            <div class="glass-card h-100">

                <div class="d-flex
                    justify-content-between">

                    <span class="request-id">
                        #INS-@item.Id.ToString("D5")
                    </span>

                    <span class="status-badge">
                        @item.Estado
                    </span>

                </div>

                <h4 class="mt-3">
                    @item.Cliente
                </h4>

                <p>
                    @item.Producto
                </p>

                <p class="small">
                    <strong>Instalador:</strong>
                    @(item.Instalador?.NombreCompleto ?? "Sin asignar")
                </p>

                <p class="small">
                    <strong>Fecha:</strong>
                    @(item.FechaInstalacion.ToString("dd/MM/yyyy"))
                </p>

                <div class="d-grid gap-2">
                    @if (item.Estado != "Finalizada" && item.FechaFinalizacion == null && !item.InstalacionRealizada)
                    {
                        <a class="btn btn-glassflow" asp-action="Reasignar" asp-route-id="@item.Id">Reasignar / reprogramar</a>
                    }
                    <span class="small text-muted">El checklist se gestiona desde la cuenta del instalador.</span>
                </div>

            </div>

        </div>
    }

</div>