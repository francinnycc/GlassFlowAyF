@model IEnumerable<GlassFlowAyF.Models.Compra>

@{
    ViewData["Title"] = "Mis compras";
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            MIS PROYECTOS
        </span>

        <h1>
            Mis compras
        </h1>

        <p>
            Consulta órdenes, pagos y facturas.
        </p>

    </div>

</div>


@if (!Model.Any())
{
    <div class="glass-card text-center py-5">

        <i class="bi bi-bag fs-1 text-muted"></i>

        <h4 class="mt-3">
            Aún no tienes compras
        </h4>

        <p class="text-muted">
            Cuando apruebes y confirmes una cotización,
            tu compra aparecerá aquí.
        </p>

        <a asp-controller="Cotizaciones"
               asp-action="MisSolicitudes"
               class="btn btn-glassflow">

            Ver mis solicitudes

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var compra in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="glass-card h-100 d-flex flex-column">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        gap-3">

                        <span class="request-id">
                            @compra.NumeroOrden
                        </span>

                        <span class="status-badge">
                            @compra.Estado
                        </span>

                    </div>


                    <h4 class="mt-3">

                        @(compra.Cotizacion?
                            .SolicitudCotizacion?
                            .Producto?
                            .Nombre
                            ?? compra.Cotizacion?
                            .SolicitudCotizacion?
                            .TipoProducto
                            ?? "Proyecto GlassFlow")

                    </h4>


                    <div class="mt-2">

                        <div class="small text-muted">
                            Total
                        </div>

                        <div class="fs-5 fw-bold">
                            ₡@compra.Total.ToString("N2")
                        </div>

                    </div>


                    <div class="small text-muted mt-3">

                        <i class="bi bi-calendar3 me-1"></i>

                        @(compra.FechaCompra.ToString(
                            "dd/MM/yyyy hh:mm tt"))

                    </div>


                    @if (compra.FechaPago.HasValue)
                    {
                        <div class="small text-success mt-2">

                            <i class="bi bi-check-circle me-1"></i>

                            Pagado:
                            @(compra.FechaPago.Value.ToString(
                                "dd/MM/yyyy hh:mm tt"))

                        </div>
                    }


                    <div class="mt-auto pt-4">

                        <a asp-action="Details"
                               asp-route-id="@compra.Id"
                               class="btn btn-outline-primary w-100">

                            Ver compra

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}