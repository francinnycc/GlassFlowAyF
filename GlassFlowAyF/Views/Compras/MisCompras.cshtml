@model IEnumerable<GlassFlowAyF.Models.Compra>

@{
    ViewData["Title"] = "Mis compras";
}

<div class="page-header">

    <div>

        <h1>
            Mis compras
        </h1>

        <p>
            Consulta órdenes,
            pagos y facturas.
        </p>

    </div>

</div>


<div class="row g-4">

    @foreach (var compra in Model)
    {
        <div class="col-md-6 col-xl-4">

            <div class="glass-card h-100">

                <div class="d-flex
                            justify-content-between">

                    <span class="request-id">
                        @compra.NumeroOrden
                    </span>

                    <span class="status-badge">
                        @compra.Estado
                    </span>

                </div>


                <h4 class="mt-3">

                    @(
                        compra.Cotizacion?
                            .SolicitudCotizacion?
                            .Producto?
                            .Nombre
                        ??
                        compra.Cotizacion?
                            .SolicitudCotizacion?
                            .TipoProducto
                    )

                </h4>


                <p class="fs-5 fw-bold">

                    ₡@compra.Total.ToString("N2")

                </p>


                <p class="small text-muted">

                    @compra.FechaCompra
                        .ToString("dd/MM/yyyy")

                </p>


                <a asp-action="Details"
                   asp-route-id="@compra.Id"
                   class="btn
                          btn-outline-primary
                          w-100">

                    Ver compra

                </a>

            </div>

        </div>
    }

</div>