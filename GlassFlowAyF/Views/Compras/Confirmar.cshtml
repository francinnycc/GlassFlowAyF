@{
    ViewData["Title"] = "Confirmar compra";

    var cotizacion =
        ViewBag.Cotizacion
        as GlassFlowAyF.Models.Cotizacion;

    var solicitud =
        cotizacion?.SolicitudCotizacion;
}


<div class="page-header">

    <div>

        <span class="eyebrow">
            CONFIRMACIÓN DE COMPRA
        </span>

        <h1>
            Confirmar compra
        </h1>

        <p>
            Revisa la información de tu proyecto
            antes de generar la orden.
        </p>

    </div>

</div>


@if (cotizacion == null)
{
    <div class="alert alert-danger">

        No fue posible cargar
        la información de la cotización.

    </div>
}
else
{
    <div class="row g-4">


        <!-- ============================= -->
        <!-- RESUMEN DEL PROYECTO -->
        <!-- ============================= -->

        <div class="col-lg-7">

            <div class="glass-card mb-4">

                <div class="d-flex
                    justify-content-between
                    align-items-start">

                    <div>

                        <span class="eyebrow">
                            PROYECTO
                        </span>

                        <h3 class="mt-1 mb-0">

                            @(solicitud?.Producto?.Nombre
                                ?? solicitud?.TipoProducto
                                ?? "Proyecto GlassFlow")

                        </h3>

                    </div>


                    <span class="status-badge">

                        @cotizacion.Estado

                    </span>

                </div>


                <hr />


                <dl class="row mb-0">


                    <dt class="col-sm-4">
                        Cotización
                    </dt>

                    <dd class="col-sm-8">

                        COT-@cotizacion.Id.ToString("D5")

                    </dd>


                    <dt class="col-sm-4">
                        Cliente
                    </dt>

                    <dd class="col-sm-8">

                        @(solicitud?.NombreCliente
                            ?? "No registrado")

                    </dd>


                    <dt class="col-sm-4">
                        Producto
                    </dt>

                    <dd class="col-sm-8">

                        @(solicitud?.Producto?.Nombre
                            ?? solicitud?.TipoProducto
                            ?? "No registrado")

                    </dd>


                    <dt class="col-sm-4">
                        Material
                    </dt>

                    <dd class="col-sm-8">

                        @(solicitud?.Material?.Nombre
                            ?? "No registrado")

                    </dd>


                    <dt class="col-sm-4">
                        Medidas
                    </dt>

                    <dd class="col-sm-8">

                        @if (solicitud?.Ancho != null &&
                             solicitud?.Alto != null)
                        {
                            <span>

                                @solicitud.Ancho.Value.ToString("0.00") m
                                ×
                                @solicitud.Alto.Value.ToString("0.00") m

                                @if (solicitud.Profundidad.HasValue)
                                {
                                    <text>
                                        ×
                                        @solicitud.Profundidad.Value.ToString("0.00") m
                                    </text>
                                }

                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No registradas
                            </span>
                        }

                    </dd>


                    <dt class="col-sm-4">
                        Instalación
                    </dt>

                    <dd class="col-sm-8">

                        @(solicitud?.RequiereInstalacion == true
                            ? "Sí"
                            : "No")

                    </dd>


                    <dt class="col-sm-4">
                        Dirección
                    </dt>

                    <dd class="col-sm-8">

                        @(string.IsNullOrWhiteSpace(
                            solicitud?.Direccion)
                            ? "No indicada"
                            : solicitud!.Direccion)

                    </dd>


                    <dt class="col-sm-4">
                        Vigencia
                    </dt>

                    <dd class="col-sm-8">

                        @cotizacion.FechaVencimiento.ToString("dd/MM/yyyy")

                    </dd>

                </dl>

            </div>


            <!-- ============================= -->
            <!-- DESGLOSE -->
            <!-- ============================= -->

            <div class="glass-card">

                <h4>
                    Resumen económico
                </h4>

                <p class="text-muted">
                    Los valores provienen de la
                    cotización que ya aprobaste.
                </p>


                <div class="table-responsive mt-3">

                    <table class="table align-middle">

                        <tbody>

                            <tr>

                                <td>
                                    Materiales
                                </td>

                                <td class="text-end">

                                    ₡@cotizacion.CostoMateriales.ToString("N2")

                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Mano de obra
                                </td>

                                <td class="text-end">

                                    ₡@cotizacion.ManoObra.ToString("N2")

                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Instalación
                                </td>

                                <td class="text-end">

                                    ₡@cotizacion.CostoInstalacion.ToString("N2")

                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Otros costos
                                </td>

                                <td class="text-end">

                                    ₡@cotizacion.OtrosCostos.ToString("N2")

                                </td>

                            </tr>


                            <tr class="border-top">

                                <td>
                                    Subtotal
                                </td>

                                <td class="text-end">

                                    ₡@cotizacion.Subtotal.ToString("N2")

                                </td>

                            </tr>


                            <tr>

                                <td>

                                    Impuesto
                                    (@cotizacion.PorcentajeImpuesto.ToString("0.##")%)

                                </td>

                                <td class="text-end">

                                    ₡@cotizacion.Impuesto.ToString("N2")

                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Descuento
                                </td>

                                <td class="text-end text-success">

                                    - ₡@cotizacion.Descuento.ToString("N2")

                                </td>

                            </tr>


                            <tr class="fw-bold fs-5">

                                <td>
                                    TOTAL
                                </td>

                                <td class="text-end">

                                    ₡@cotizacion.Total.ToString("N2")

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

        </div>



        <!-- ============================= -->
        <!-- CONFIRMAR ORDEN -->
        <!-- ============================= -->

        <div class="col-lg-5">

            <form asp-controller="Compras"
                  asp-action="Confirmar"
                  method="post"
                  class="glass-card">


                <input type="hidden"
                       name="cotizacionId"
                       value="@cotizacion.Id" />


                <div class="text-center mb-4">

                    <div class="stat-icon mx-auto">

                        <i class="bi bi-bag-check">
                        </i>

                    </div>


                    <h4 class="mt-3">
                        Crear orden de compra
                    </h4>


                    <p class="text-muted">

                        La cotización ya fue aprobada.
                        Selecciona cómo deseas realizar
                        el pago.

                    </p>

                </div>


                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        Método de pago

                    </label>


                    <select name="metodoPago"
                            class="form-select"
                            required>

                        <option value="">

                            Seleccione...

                        </option>


                        <option value="Transferencia">

                            Transferencia bancaria

                        </option>


                        <option value="SINPE">

                            SINPE

                        </option>


                        <option value="Pago en oficina">

                            Pago en oficina

                        </option>

                    </select>

                </div>


                <div class="mb-4">

                    <label class="form-label">

                        Observaciones
                        <span class="text-muted">
                            (opcional)
                        </span>

                    </label>


                    <textarea name="observaciones"
                          class="form-control"
                          rows="3"
                              placeholder="Información adicional sobre tu compra o pago...">
                    </textarea>

                </div>


                <div class="p-3
                    rounded
                    bg-light
                    mb-4">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <span>
                            Total de la orden
                        </span>


                        <strong class="fs-4">

                            ₡@cotizacion.Total.ToString("N2")

                        </strong>

                    </div>

                </div>


                <div class="alert alert-info">

                    <i class="bi bi-info-circle me-1">
                    </i>

                    Al confirmar se generará una
                    orden de compra con estado
                    <strong>Pendiente de pago</strong>.

                    El administrador deberá confirmar
                    posteriormente la recepción del pago.

                </div>


                <button type="submit"
                        class="btn
                    btn-glassflow
                    btn-lg
                    w-100">

                    <i class="bi bi-check-circle me-1">
                    </i>

                    Confirmar compra por
                    ₡@cotizacion.Total.ToString("N2")

                </button>


                <a asp-controller="Cotizaciones"
                       asp-action="VerCotizacion"
                       asp-route-id="@cotizacion.Id"
                       class="btn
                    btn-outline-secondary
                    w-100
                    mt-2">

                    Volver a la cotización

                </a>

            </form>

        </div>

    </div>
}