@model GlassFlowAyF.Models.Compra

@{
    ViewData["Title"] = "Detalle de compra";

    var solicitud = Model.Cotizacion?.SolicitudCotizacion;

    var producto =
        solicitud?.Producto?.Nombre
        ?? solicitud?.TipoProducto
        ?? "Proyecto GlassFlow";
}

<div class="page-header">

    <div>
        <span class="eyebrow">
            COMPRA
        </span>

        <h1>
            Detalle de compra
        </h1>

        <p>
            Consulta la información de tu orden,
            pago y factura.
        </p>
    </div>

    <a asp-action="MisCompras"
           class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Mis compras

    </a>

</div>


<div class="row g-4">

    <!-- =========================================================
         COLUMNA PRINCIPAL
    ========================================================== -->
    <div class="col-lg-8">

        <!-- INFORMACIÓN DE LA COMPRA -->
        <div class="glass-card mb-4">

            <div class="d-flex
                justify-content-between
                align-items-start
                gap-3">

                <div>

                    <span class="request-id">
                        @Model.NumeroOrden
                    </span>

                    <h3 class="mt-2 mb-1">
                        @producto
                    </h3>

                    <span class="status-badge">
                        @Model.Estado
                    </span>

                </div>

                <div class="text-end">

                    <div class="small text-muted">
                        Total
                    </div>

                    <div class="fs-3 fw-bold">
                        ₡@(Model.Total.ToString("N2"))
                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <h5>
                Información de la compra
            </h5>


            <dl class="row mt-4">

                <dt class="col-sm-4">
                    Número de orden
                </dt>

                <dd class="col-sm-8">
                    @Model.NumeroOrden
                </dd>


                <dt class="col-sm-4">
                    Producto
                </dt>

                <dd class="col-sm-8">
                    @producto
                </dd>


                <dt class="col-sm-4">
                    Método de pago
                </dt>

                <dd class="col-sm-8">

                    @(string.IsNullOrWhiteSpace(Model.MetodoPago)
                        ? "No registrado"
                        : Model.MetodoPago)

                </dd>


                <dt class="col-sm-4">
                    Fecha de compra
                </dt>

                <dd class="col-sm-8">

                    @(Model.FechaCompra.ToString(
                        "dd/MM/yyyy hh:mm tt"))

                </dd>


                <dt class="col-sm-4">
                    Fecha de pago
                </dt>

                <dd class="col-sm-8">

                    @if (Model.FechaPago.HasValue)
                    {
                        <span class="text-success">

                            <i class="bi bi-check-circle me-1"></i>

                            @(Model.FechaPago.Value.ToString(
                                "dd/MM/yyyy hh:mm tt"))

                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            Pendiente
                        </span>
                    }

                </dd>


                <dt class="col-sm-4">
                    Estado
                </dt>

                <dd class="col-sm-8">

                    <span class="status-badge">
                        @Model.Estado
                    </span>

                </dd>


                @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                {
                    <dt class="col-sm-4">
                        Observaciones
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Observaciones
                    </dd>
                }

            </dl>

        </div>


        <!-- =====================================================
             INFORMACIÓN DEL PROYECTO
        ====================================================== -->
        @if (solicitud != null)
        {
            <div class="glass-card mb-4">

                <h5>
                    Información del proyecto
                </h5>

                <dl class="row mt-4">

                    <dt class="col-sm-4">
                        Cliente
                    </dt>

                    <dd class="col-sm-8">
                        @solicitud.NombreCliente
                    </dd>


                    <dt class="col-sm-4">
                        Producto
                    </dt>

                    <dd class="col-sm-8">
                        @producto
                    </dd>


                    <dt class="col-sm-4">
                        Material
                    </dt>

                    <dd class="col-sm-8">

                        @(solicitud.Material?.Nombre
                            ?? "No registrado")

                    </dd>


                    <dt class="col-sm-4">
                        Medidas
                    </dt>

                    <dd class="col-sm-8">

                        @if (solicitud.Ancho.HasValue &&
                             solicitud.Alto.HasValue)
                        {
                            <span>

                                @(solicitud.Ancho.Value.ToString("0.00")) m
                                ×
                                @(solicitud.Alto.Value.ToString("0.00")) m

                                @if (solicitud.Profundidad.HasValue)
                                {
                                    <text>
                                        ×
                                        @(solicitud.Profundidad.Value.ToString("0.00")) m
                                    </text>
                                }

                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                No registradas
                            </span>
                        }

                    </dd>


                    <dt class="col-sm-4">
                        Cantidad
                    </dt>

                    <dd class="col-sm-8">
                        @solicitud.Cantidad
                    </dd>


                    <dt class="col-sm-4">
                        Instalación
                    </dt>

                    <dd class="col-sm-8">

                        @if (solicitud.RequiereInstalacion)
                        {
                            <span class="text-success">

                                <i class="bi bi-check-circle me-1"></i>

                                Sí

                            </span>
                        }
                        else
                        {
                            <span>
                                No
                            </span>
                        }

                    </dd>


                    <dt class="col-sm-4">
                        Dirección
                    </dt>

                    <dd class="col-sm-8">

                        @(string.IsNullOrWhiteSpace(solicitud.Direccion)
                            ? "No registrada"
                            : solicitud.Direccion)

                    </dd>

                </dl>

            </div>
        }


        <!-- =====================================================
             DESGLOSE ECONÓMICO
        ====================================================== -->
        @if (Model.Cotizacion != null)
        {
            <div class="glass-card">

                <h5>
                    Desglose económico
                </h5>

                <div class="table-responsive mt-3">

                    <table class="table align-middle">

                        <tbody>

                            <tr>
                                <td>
                                    Materiales
                                </td>

                                <td class="text-end">
                                    ₡@(Model.Cotizacion.CostoMateriales.ToString("N2"))
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    Mano de obra
                                </td>

                                <td class="text-end">
                                    ₡@(Model.Cotizacion.ManoObra.ToString("N2"))
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    Instalación
                                </td>

                                <td class="text-end">
                                    ₡@(Model.Cotizacion.CostoInstalacion.ToString("N2"))
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    Otros costos
                                </td>

                                <td class="text-end">
                                    ₡@(Model.Cotizacion.OtrosCostos.ToString("N2"))
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    Subtotal
                                </td>

                                <td class="text-end">
                                    ₡@(Model.Cotizacion.Subtotal.ToString("N2"))
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    Impuesto
                                </td>

                                <td class="text-end">
                                    ₡@(Model.Cotizacion.Impuesto.ToString("N2"))
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    Descuento
                                </td>

                                <td class="text-end text-success">
                                    - ₡@(Model.Cotizacion.Descuento.ToString("N2"))
                                </td>
                            </tr>


                            <tr class="fw-bold">

                                <td>
                                    TOTAL
                                </td>

                                <td class="text-end fs-5">
                                    ₡@(Model.Total.ToString("N2"))
                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>
        }

    </div>


    <!-- =========================================================
         COLUMNA DERECHA
    ========================================================== -->
    <div class="col-lg-4">

        <!-- ESTADO -->
        <div class="glass-card mb-4">

            <h5>
                Estado de la orden
            </h5>

            <p class="text-muted">
                Seguimiento actual de la compra.
            </p>


            <div class="mt-4">

                <span class="status-badge">
                    @Model.Estado
                </span>

            </div>


            <hr class="my-4" />


            @if (Model.FechaPago.HasValue)
            {
                <div class="d-flex
                    align-items-center
                    gap-3">

                    <div class="stat-icon">

                        <i class="bi bi-check-lg"></i>

                    </div>

                    <div>

                        <strong>
                            Pago registrado
                        </strong>

                        <div class="small text-muted">

                            @(Model.FechaPago.Value.ToString(
                                "dd/MM/yyyy hh:mm tt"))

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="d-flex
                    align-items-center
                    gap-3">

                    <div class="stat-icon">

                        <i class="bi bi-hourglass-split"></i>

                    </div>

                    <div>

                        <strong>
                            Pago pendiente
                        </strong>

                        <div class="small text-muted">
                            La orden aún no registra pago.
                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- =====================================================
             FACTURA
        ====================================================== -->
        @if (Model.Factura != null)
        {
            <div class="glass-card">

                <div class="text-center">

                    <div class="auth-logo">

                        <i class="bi bi-receipt"></i>

                    </div>

                    <h4>
                        Factura disponible
                    </h4>

                    <p class="text-muted">
                        @Model.Factura.NumeroFactura
                    </p>

                </div>


                <div class="small mt-4">

                    <div class="d-flex
                        justify-content-between
                        mb-3">

                        <span>
                            Fecha de emisión
                        </span>

                        <strong>

                            @(Model.Factura.FechaEmision
                                .ToString("dd/MM/yyyy"))

                        </strong>

                    </div>


                    <div class="d-flex
                        justify-content-between">

                        <span>
                            Total
                        </span>

                        <strong>
                            ₡@(Model.Factura.Total.ToString("N2"))
                        </strong>

                    </div>

                </div>
                <a asp-action="ExportarFacturaExcel"
                       asp-route-id="@Model.Factura.Id"
                       class="btn btn-glassflow w-100 mt-4">

                    <i class="bi bi-file-earmark-excel me-1"></i>

                    Descargar factura Excel

                </a>

            </div>
        }
        else
        {
            <div class="glass-card text-center">

                <i class="bi bi-receipt fs-2 text-muted"></i>

                <h5 class="mt-3">
                    Factura pendiente
                </h5>

                <p class="text-muted mb-0">

                    La factura se habilitará
                    cuando corresponda dentro del proceso.

                </p>

            </div>
        }

    </div>

</div>