@model GlassFlowAyF.Models.SoporteSolicitud

@{
    ViewData["Title"] = "Detalle de soporte";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-xl-9">

            <div class="d-flex
                        justify-content-between
                        align-items-center
                        mb-4">

                <div>

                    <h1 class="h3 mb-1">
                        Solicitud SUP-@Model.Id.ToString("D4")
                    </h1>

                    <p class="text-muted mb-0">
                        Seguimiento de tu solicitud de soporte.
                    </p>

                </div>

                <a asp-action="MisSolicitudes"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Volver

                </a>

            </div>


            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-3">

                            <small class="text-muted">
                                Tipo
                            </small>

                            <div class="fw-semibold">
                                @Model.Tipo
                            </div>

                        </div>


                        <div class="col-md-3">

                            <small class="text-muted">
                                Categoría
                            </small>

                            <div class="fw-semibold">
                                @Model.Categoria
                            </div>

                        </div>


                        <div class="col-md-3">

                            <small class="text-muted">
                                Fecha
                            </small>

                            <div class="fw-semibold">
                                @Model.FechaCreacion.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </div>

                        </div>


                        <div class="col-md-3">

                            <small class="text-muted">
                                Estado
                            </small>

                            <div class="fw-semibold">
                                @Model.Estado
                            </div>

                        </div>

                    </div>


                    <hr />


                    <h5>
                        @Model.Asunto
                    </h5>

                    <p class="mb-0"
                       style="white-space:pre-line;">
                        @Model.Mensaje
                    </p>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Respuesta))
            {
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-light">

                        <strong>
                            <i class="bi bi-headset me-2"></i>
                            Respuesta de GlassFlow A&amp;F
                        </strong>

                    </div>

                    <div class="card-body p-4">

                        <p style="white-space:pre-line;">
                            @Model.Respuesta
                        </p>

                        @if (Model.FechaRespuesta.HasValue)
                        {
                            <small class="text-muted">
                                Respondido el
                                @Model.FechaRespuesta.Value.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </small>
                        }

                    </div>

                </div>
            }


            @if ((Model.Estado == "Respondido" ||
                  Model.Estado == "Cerrado") &&
                 !Model.Calificacion.HasValue)
            {
                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h5>
                            <i class="bi bi-star me-2"></i>
                            Calificar atención
                        </h5>

                        <p class="text-muted">
                            Cuéntanos cómo fue la atención recibida.
                        </p>


                        <form asp-action="Calificar"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />


                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Calificación
                                </label>

                                <select name="calificacion"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Seleccione
                                    </option>

                                    <option value="5">
                                        5 - Excelente
                                    </option>

                                    <option value="4">
                                        4 - Muy buena
                                    </option>

                                    <option value="3">
                                        3 - Buena
                                    </option>

                                    <option value="2">
                                        2 - Regular
                                    </option>

                                    <option value="1">
                                        1 - Mala
                                    </option>

                                </select>

                            </div>


                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Comentario
                                </label>

                                <textarea name="comentario"
                                          class="form-control"
                                          maxlength="1000"
                                          rows="4"
                                          placeholder="Comentario opcional"></textarea>

                            </div>


                            <button type="submit"
                                    class="btn btn-glassflow">

                                <i class="bi bi-star me-1"></i>
                                Enviar calificación

                            </button>

                        </form>

                    </div>

                </div>
            }


            @if (Model.Calificacion.HasValue)
            {
                <div class="alert alert-success">

                    <strong>
                        Atención calificada:
                    </strong>

                    @Model.Calificacion / 5

                    <i class="bi bi-star-fill text-warning"></i>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.ComentarioCalificacion))
                    {
                        <div class="mt-2">
                            @Model.ComentarioCalificacion
                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>