@model IEnumerable<GlassFlowAyF.Models.SoporteSolicitud>

@{
    ViewData["Title"] = "Mis solicitudes de soporte";
}

<div class="container-fluid">

    <div class="d-flex
                justify-content-between
                align-items-center
                flex-wrap
                gap-3
                mb-4">

        <div>

            <h1 class="h3 mb-1">
                <i class="bi bi-chat-square-text me-2"></i>
                Mis solicitudes de soporte
            </h1>

            <p class="text-muted mb-0">
                Consulta el estado de tus consultas y reclamos.
            </p>

        </div>


        <a asp-action="Create"
           class="btn btn-glassflow">

            <i class="bi bi-plus-lg me-1"></i>
            Nueva solicitud

        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center p-5">

                <i class="bi bi-chat-dots"
                   style="font-size:3rem;color:#00aeb3;">
                </i>

                <h2 class="h5 mt-3">
                    No tienes solicitudes de soporte
                </h2>

                <p class="text-muted">
                    Puedes enviar una consulta o registrar
                    un reclamo cuando lo necesites.
                </p>

                <a asp-action="Create"
                   class="btn btn-glassflow">

                    Contactar soporte

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="table-responsive">

                <table class="table
                              table-hover
                              align-middle
                              mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Tipo</th>
                            <th>Asunto</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Calificación</th>
                            <th></th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    SUP-@item.Id.ToString("D4")
                                </td>

                                <td>
                                    @item.Tipo
                                </td>

                                <td>
                                    @item.Asunto
                                </td>

                                <td>
                                    @item.FechaCreacion.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>

                                    @if (item.Estado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pendiente
                                        </span>
                                    }
                                    else if (item.Estado == "En revisión")
                                    {
                                        <span class="badge bg-info text-dark">
                                            En revisión
                                        </span>
                                    }
                                    else if (item.Estado == "Respondido")
                                    {
                                        <span class="badge bg-success">
                                            Respondido
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Estado
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.Calificacion.HasValue)
                                    {
                                        <span>
                                            @item.Calificacion / 5
                                            <i class="bi bi-star-fill text-warning"></i>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm">

                                        Ver detalle

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>