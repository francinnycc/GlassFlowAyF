@model GlassFlowAyF.Models.ViewModels.ResponderSoporteViewModel

@{
    ViewData["Title"] = "Responder solicitud";
}

<div class="container-fluid">

    <div class="row justify-content-center">

        <div class="col-xl-9">

            <div class="mb-4">

                <h1 class="h3 mb-1">
                    Gestionar solicitud SUP-@Model.Id.ToString("D4")
                </h1>

                <p class="text-muted">
                    Responde la consulta o reclamo del cliente.
                </p>

            </div>


            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body p-4">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted">
                                Cliente
                            </small>

                            <div class="fw-semibold">
                                @Model.Cliente
                            </div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">
                                Correo
                            </small>

                            <div class="fw-semibold">
                                @Model.Email
                            </div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">
                                Tipo
                            </small>

                            <div class="fw-semibold">
                                @Model.Tipo
                            </div>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">
                                Categoría
                            </small>

                            <div class="fw-semibold">
                                @Model.Categoria
                            </div>
                        </div>

                    </div>


                    <hr />


                    <h5>
                        @Model.Asunto
                    </h5>

                    <p style="white-space:pre-line;">
                        @Model.Mensaje
                    </p>

                </div>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Responder"
                          method="post">

                        <input asp-for="Id"
                               type="hidden" />

                        <input asp-for="Cliente"
                               type="hidden" />

                        <input asp-for="Email"
                               type="hidden" />

                        <input asp-for="Tipo"
                               type="hidden" />

                        <input asp-for="Categoria"
                               type="hidden" />

                        <input asp-for="Asunto"
                               type="hidden" />

                        <input asp-for="Mensaje"
                               type="hidden" />


                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="mb-4">

                            <label asp-for="Estado"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Estado"
                                    class="form-select">

                                <option value="En revisión">
                                    En revisión
                                </option>

                                <option value="Respondido">
                                    Respondido
                                </option>

                                <option value="Cerrado">
                                    Cerrado
                                </option>

                            </select>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Respuesta"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Respuesta"
                                      class="form-control"
                                      rows="7"
                                      placeholder="Escribe la respuesta para el cliente..."></textarea>

                            <span asp-validation-for="Respuesta"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Administrar"
                               class="btn btn-outline-secondary">

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-glassflow">

                                <i class="bi bi-send-check me-1"></i>
                                Guardar respuesta

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}