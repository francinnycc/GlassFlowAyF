@model GlassFlowAyF.Models.ViewModels.PropuestaVisualFormViewModel
@using GlassFlowAyF.Models
@{
    var disenos = ViewBag.Disenos as List<DisenoIA> ?? new List<DisenoIA>();
}

<div class="mb-3">
    <label asp-for="Titulo" class="form-label fw-bold"></label>
    <input asp-for="Titulo" class="form-control" maxlength="120" placeholder="Ej.: Ventana corrediza sala principal" />
    <span asp-validation-for="Titulo" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Descripcion" class="form-label fw-bold"></label>
    <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="2000"
              placeholder="Describa acabados, distribución, color de perfilería y observaciones del diseño."></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="DisenoIAId" class="form-label fw-bold"></label>
    <select asp-for="DisenoIAId" class="form-select">
        <option value="">Sin diseño IA base</option>
        @foreach (var d in disenos)
        {
            <option value="@d.Id">@d.Estilo · @(d.ColorPerfil ?? "sin color") · @d.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</option>
        }
    </select>
    <div class="form-text">Reutiliza los diseños generados con IA para esta solicitud. La IA solo apoya; la propuesta la valida el cotizador.</div>
    <span asp-validation-for="DisenoIAId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Archivos" class="form-label fw-bold"></label>
    <input asp-for="Archivos" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png,.pdf,.dwg" />
    <div class="form-text">Formatos admitidos: .JPG, .PNG, .PDF o .DWG, máximo 15 MB por archivo.</div>
    <span asp-validation-for="Archivos" class="text-danger"></span>
</div>
