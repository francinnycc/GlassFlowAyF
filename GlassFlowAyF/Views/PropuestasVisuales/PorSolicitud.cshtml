@model IEnumerable<GlassFlowAyF.Models.PropuestaVisual>
@using GlassFlowAyF.Models
@{
    ViewData["Title"] = "Propuestas de la solicitud";
    var solicitud = (SolicitudCotizacion)ViewBag.Solicitud;
    var esAdmin = User.IsInRole("Administrador");
}

<div class="page-header">
    <div>
        <span class="eyebrow">DISEÑO Y PROPUESTA VISUAL</span>
        <h1>Propuesta visual del proyecto</h1>
        <p>SOL-@solicitud.Id.ToString("D5") · @solicitud.NombreCliente · @(solicitud.Producto?.Nombre ?? solicitud.TipoProducto)</p>
    </div>
    <div class="d-flex gap-2">
        @if (esAdmin)
        {
            <a asp-controller="Cotizaciones" asp-action="Details" asp-route-id="@solicitud.Id" class="btn btn-outline-secondary">Volver a la solicitud</a>
            <a asp-action="Crear" asp-route-solicitudId="@solicitud.Id" class="btn btn-glassflow">Nueva propuesta</a>
        }
        else
        {
            <a asp-action="MisPropuestas" class="btn btn-outline-secondary">Volver</a>
        }
    </div>
</div>

@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }

@if (!Model.Any())
{
    <div class="glass-card text-center py-5">
        <i class="bi bi-hourglass-split display-5 text-muted"></i>
        <p class="mt-3 mb-0">
            La propuesta visual de su proyecto se encuentra actualmente en desarrollo por nuestro equipo técnico.
            Le notificaremos cuando esté disponible para su revisión.
        </p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-md-6">
                <div class="glass-card h-100">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="text-muted small">@p.Codigo · @p.VersionTexto</div>
                            <h5 class="mb-1">@p.Titulo</h5>
                        </div>
                        <span class="badge bg-primary">@p.Estado</span>
                    </div>
                    <p class="text-muted small mt-2" style="white-space:pre-wrap">@p.Descripcion</p>
                    <p class="small mb-3">
                        @p.Archivos.Count adjunto(s) · @((p.FechaActualizacion ?? p.FechaCreacion).ToString("dd/MM/yyyy HH:mm"))
                    </p>
                    <a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-outline-primary">Ver propuesta</a>
                </div>
            </div>
        }
    </div>
}
