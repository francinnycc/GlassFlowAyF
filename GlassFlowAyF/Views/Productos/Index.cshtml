@model IEnumerable<GlassFlowAyF.Models.Producto>

@{
    ViewData["Title"] = "Catálogo";
}

<div class="page-header">

    <div>
        <span class="eyebrow">
            CATÁLOGO
        </span>

        <h1>
            Productos y soluciones
        </h1>

        <p>
            Explora nuestras soluciones
            en vidrio y aluminio.
        </p>
    </div>

    @if (User.IsInRole("Administrador"))
    {
        <a asp-action="Administrar"
           class="btn btn-glassflow">

            <i class="bi bi-gear me-1"></i>
            Administrar productos
        </a>
    }

</div>


<div class="glass-card mb-4">

    <form method="get"
          asp-action="Index"
          class="row g-3">

        <div class="col-md-6">

            <input type="text"
                   name="buscar"
                   value="@ViewBag.Buscar"
                   class="form-control"
                   placeholder="Buscar productos..." />

        </div>

        <div class="col-md-4">

            <select name="categoria"
                    class="form-select">

                <option value="">
                    Todas las categorías
                </option>

                @foreach (var categoria in ViewBag.Categorias)
                {
                    if (ViewBag.Categoria == categoria)
                    {
                        <option value="@categoria"
                                selected>
                            @categoria
                        </option>
                    }
                    else
                    {
                        <option value="@categoria">
                            @categoria
                        </option>
                    }
                }

            </select>

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-glassflow w-100">

                <i class="bi bi-search me-1"></i>
                Buscar

            </button>

        </div>

    </form>

</div>


@if (!Model.Any())
{
    <div class="glass-card text-center py-5">

        <i class="bi bi-search fs-1 text-muted"></i>

        <h4 class="mt-3">
            No encontramos productos
        </h4>

        <p class="text-muted">
            Prueba con otra búsqueda o categoría.
        </p>

        <a asp-action="Index"
           class="btn btn-outline-primary">

            Mostrar todo el catálogo

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var producto in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="product-card h-100 d-flex flex-column">

                    <!-- IMAGEN DEL PRODUCTO -->
                    <a asp-action="Details"
                       asp-route-id="@producto.Id"
                       class="text-decoration-none">

                        <div class="product-image">

                            @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                            {
                                <img src="@producto.ImagenUrl"
                                     alt="@producto.Nombre"
                                     loading="lazy"
                                     onerror="
                                        this.style.display='none';
                                        this.nextElementSibling.style.display='flex';" />

                                <div class="product-no-image"
                                     style="display:none;">

                                    <i class="bi bi-image"></i>

                                </div>
                            }
                            else
                            {
                                <div class="product-no-image">

                                    <i class="bi bi-image"></i>

                                </div>
                            }

                        </div>

                    </a>


                    <!-- INFORMACIÓN DEL PRODUCTO -->
                    <div class="p-4 d-flex flex-column flex-grow-1">

                        <span class="product-category">
                            @producto.Categoria
                        </span>


                        <!-- NOMBRE CLICKEABLE -->
                        <a asp-action="Details"
                           asp-route-id="@producto.Id"
                           class="text-decoration-none text-dark">

                            <h4 class="mt-2 mb-2">
                                @producto.Nombre
                            </h4>

                        </a>


                        <p class="text-muted product-description">

                            @(string.IsNullOrWhiteSpace(producto.Descripcion)
                                ? "Solución personalizada fabricada según las necesidades del proyecto."
                                : producto.Descripcion)

                        </p>


                        <div class="mt-auto">

                            <!-- PRECIO -->
                            <div class="product-price">

                                @if (producto.PrecioBase > 0)
                                {
                                    <span>
                                        Desde
                                    </span>

                                    <strong>
                                        ₡@producto.PrecioBase.ToString("N0")
                                    </strong>
                                }
                                else
                                {
                                    <span>
                                        Precio
                                    </span>

                                    <strong>
                                        Consultar
                                    </strong>
                                }

                            </div>


                            <!-- INSTALACIÓN -->
                            @if (producto.PermiteInstalacion)
                            {
                                <div class="small text-success mt-2">

                                    <i class="bi bi-check-circle me-1"></i>

                                    Instalación disponible

                                </div>
                            }
                            else
                            {
                                <div class="small text-muted mt-2">

                                    <i class="bi bi-box me-1"></i>

                                    Producto sin instalación

                                </div>
                            }


                            <!-- ACCIONES -->
                            <div class="d-grid gap-2 mt-3">

                                <a asp-action="Details"
                                   asp-route-id="@producto.Id"
                                   class="btn btn-outline-primary">

                                    <i class="bi bi-eye me-1"></i>

                                    Ver detalle

                                </a>


                                @if (User.IsInRole("Cliente"))
                                {
                                    <a asp-controller="Cotizaciones"
                                       asp-action="Create"
                                       asp-route-productoId="@producto.Id"
                                       class="btn btn-glassflow">

                                        <i class="bi bi-file-earmark-plus me-1"></i>

                                        Solicitar cotización

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}