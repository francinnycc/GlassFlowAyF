@model IEnumerable<GlassFlowAyF.Models.Producto>

@{
    ViewData["Title"] = "Gestión de productos";
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            ADMINISTRACIÓN
        </span>

        <h1>
            Gestión de productos
        </h1>

        <p>
            Administra el catálogo disponible
            para tus clientes.
        </p>

    </div>

    <a asp-action="Create"
           class="btn btn-glassflow">

        <i class="bi bi-plus-lg me-1"></i>
        Nuevo producto

    </a>

</div>


@if (!Model.Any())
{
    <div class="glass-card text-center py-5">

        <i class="bi bi-box-seam fs-1 text-muted"></i>

        <h4 class="mt-3">
            No existen productos
        </h4>

        <p class="text-muted">
            Crea el primer producto del catálogo.
        </p>

        <a asp-action="Create"
               class="btn btn-glassflow">

            Crear producto

        </a>

    </div>
}
else
{
    <div class="glass-card">

        <div class="table-responsive">

            <table class="table align-middle">

                <thead>

                    <tr>

                        <th>
                            Producto
                        </th>

                        <th>
                            Categoría
                        </th>

                        <th>
                            Precio
                        </th>

                        <th>
                            Instalación
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var producto in Model)
                    {
                        <tr>

                            <td>

                                <div class="d-flex
                                    align-items-center
                                    gap-3">

                                    <div style="width:52px;
                                        height:52px;
                                        flex:0 0 52px;">

                                        @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                                        {
                                            <img src="@producto.ImagenUrl"
                                                 class="product-admin-img"
                                                 alt="@producto.Nombre"
                                                 onerror="
                                            this.style.display='none';
                                            this.nextElementSibling.style.display='flex';" />

                                            <div class="product-admin-placeholder"
                                                 style="display:none;
                                                width:52px;
                                                height:52px;">

                                                <i class="bi bi-image"></i>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="product-admin-placeholder"
                                                 style="width:52px;
                                                height:52px;">

                                                <i class="bi bi-image"></i>

                                            </div>
                                        }

                                    </div>


                                    <div>

                                        <strong>
                                            @producto.Nombre
                                        </strong>

                                        <div class="small text-muted">

                                            @(string.IsNullOrWhiteSpace(producto.Descripcion)
                                                ? "Sin descripción."
                                                : producto.Descripcion)

                                        </div>

                                    </div>

                                </div>

                            </td>


                            <td>
                                @producto.Categoria
                            </td>


                            <td>

                                @if (producto.PrecioBase > 0)
                                {
                                    <strong>
                                        ₡@producto.PrecioBase.ToString("N0")
                                    </strong>
                                }
                                else
                                {
                                    <span class="text-warning">
                                        Precio pendiente
                                    </span>
                                }

                            </td>


                            <td>

                                @if (producto.PermiteInstalacion)
                                {
                                    <span class="text-success">

                                        <i class="bi bi-check-circle me-1"></i>
                                        Sí

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">

                                        <i class="bi bi-dash-circle me-1"></i>
                                        No

                                    </span>
                                }

                            </td>


                            <td>

                                @if (producto.Activo)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactivo
                                    </span>
                                }

                            </td>


                            <td class="text-end">

                                <a asp-action="Details"
                                       asp-route-id="@producto.Id"
                                       class="btn btn-sm btn-outline-secondary">

                                    Ver

                                </a>

                                <a asp-action="Edit"
                                       asp-route-id="@producto.Id"
                                       class="btn btn-sm btn-outline-primary">

                                    Editar

                                </a>


                                <form asp-action="CambiarEstado"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@producto.Id" />

                                    <button type="submit"
                                            class="btn btn-sm @(producto.Activo
                                                                                                                                    ? "btn-outline-danger"
                                                                                                                                    : "btn-outline-success")">

                                        @(producto.Activo
                                            ? "Desactivar"
                                            : "Activar")

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}