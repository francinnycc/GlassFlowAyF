@model GlassFlowAyF.Models.Producto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            @Model.Categoria
        </span>

        <h1>
            @Model.Nombre
        </h1>

        <p>
            Conoce las características
            y acabados disponibles.
        </p>

    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">

        Volver al catálogo

    </a>

</div>


<div class="row g-4">

    <div class="col-lg-6">

        <div class="product-detail-image">

            @if (!string.IsNullOrWhiteSpace(
                Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl"
                     alt="@Model.Nombre" />
            }
            else
            {
                <div class="product-no-image">
                    <i class="bi bi-window"></i>
                </div>
            }

        </div>

    </div>


    <div class="col-lg-6">

        <div class="glass-card h-100">

            <span class="product-category">
                @Model.Categoria
            </span>

            <h2 class="mt-2">
                @Model.Nombre
            </h2>

            <p class="text-muted">
                @Model.Descripcion
            </p>

            <hr />

            <div class="product-price">

                Precio base desde

                <strong>
                    ₡@Model.PrecioBase.ToString("N0")
                </strong>

            </div>


            <h5 class="mt-4">
                Materiales y acabados disponibles
            </h5>


            @if (Model.ProductoMateriales.Any())
            {
                <div class="mt-3">

                    @foreach (var relacion
                        in Model.ProductoMateriales)
                    {
                        if (relacion.Material != null &&
                            relacion.Material.Activo)
                        {
                            <div class="material-option">

                                <div>

                                    <strong>
                                        @relacion.Material.Nombre
                                    </strong>

                                    <div class="small text-muted">

                                        @relacion.Material.Color
                                        ·
                                        @relacion.Material.Perfil
                                        ·
                                        @relacion.Material.Grosor mm

                                    </div>

                                </div>

                                @if (relacion.Material.PrecioAdicional > 0)
                                {
                                    <span>
                                        +₡@relacion.Material.PrecioAdicional.ToString("N0")
                                    </span>
                                }

                            </div>
                        }
                    }

                </div>
            }


            @if (User.IsInRole("Cliente"))
            {
                <a asp-controller="Cotizaciones"
                       asp-action="Create"
                       asp-route-productoId="@Model.Id"
                       class="btn btn-glassflow w-100 mt-4">

                    Solicitar cotización

                </a>
            }

        </div>

    </div>

</div>