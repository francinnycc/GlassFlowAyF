@model GlassFlowAyF.Models.Producto

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="page-header">

    <div>

        <span class="eyebrow">
            @Model.Categoria
        </span>

        <h1>
            @Model.Nombre
        </h1>

        <p>
            Conoce las características,
            materiales y acabados disponibles.
        </p>

    </div>

    <a asp-action="Index"
           class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Volver al catálogo

    </a>

</div>


<div class="row g-4">

    <div class="col-lg-6">

        <div class="product-detail-image">

            @if (!string.IsNullOrWhiteSpace(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl"
                     alt="@Model.Nombre"
                     onerror="
                this.style.display='none';
                this.nextElementSibling.style.display='flex';" />

                <div class="product-no-image"
                     style="display:none;">

                    <i class="bi bi-image"></i>

                </div>
            }
            else
            {
                <div class="product-no-image">

                    <i class="bi bi-image"></i>

                </div>
            }

        </div>

    </div>


    <div class="col-lg-6">

        <div class="glass-card h-100">

            <span class="product-category">
                @Model.Categoria
            </span>

            <h2 class="mt-2">
                @Model.Nombre
            </h2>

            <p class="text-muted">

                @(string.IsNullOrWhiteSpace(Model.Descripcion)
                    ? "Producto personalizable según las características y necesidades del proyecto."
                    : Model.Descripcion)

            </p>


            <hr />


            <div class="product-price">

                @if (Model.PrecioBase > 0)
                {
                    <span>
                        Precio base desde
                    </span>

                    <strong>
                        ₡@Model.PrecioBase.ToString("N0")
                    </strong>
                }
                else
                {
                    <span>
                        Precio
                    </span>

                    <strong>
                        Consultar
                    </strong>
                }

            </div>


            @if (Model.PermiteInstalacion)
            {
                <div class="alert alert-light border mt-3">

                    <i class="bi bi-check-circle text-success me-2"></i>

                    Este producto dispone de servicio
                    de instalación profesional.

                </div>
            }


            <h5 class="mt-4">
                Materiales y acabados disponibles
            </h5>


            @if (Model.ProductoMateriales != null &&
                 Model.ProductoMateriales.Any(
                     pm => pm.Material != null &&
                           pm.Material.Activo))
            {
                <div class="mt-3">

                    @foreach (var relacion in
                        Model.ProductoMateriales
                            .Where(pm =>
                                pm.Material != null &&
                                pm.Material.Activo))
                    {
                        <div class="material-option">

                            <div>

                                <strong>
                                    @relacion.Material!.Nombre
                                </strong>

                                <div class="small text-muted">

                                    @if (!string.IsNullOrWhiteSpace(
                                        relacion.Material.Tipo))
                                    {
                                        <span>
                                            @relacion.Material.Tipo
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        relacion.Material.Color))
                                    {
                                        <span>
                                            · @relacion.Material.Color
                                        </span>
                                    }

                                    @if (relacion.Material.Grosor.HasValue)
                                    {
                                        <span>
                                            · @relacion.Material.Grosor.Value.ToString("0.##") mm
                                        </span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(
                                        relacion.Material.Perfil))
                                    {
                                        <span>
                                            · @relacion.Material.Perfil
                                        </span>
                                    }

                                </div>

                            </div>


                            @if (relacion.Material.PrecioAdicional > 0)
                            {
                                <span class="text-nowrap">

                                    +₡@relacion.Material.PrecioAdicional.ToString("N0")

                                </span>
                            }

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-light border mt-3">

                    <i class="bi bi-info-circle me-2"></i>

                    Los materiales y acabados
                    se definirán durante la cotización.

                </div>
            }


            @if (User.IsInRole("Cliente"))
            {
                <a asp-controller="Cotizaciones"
                       asp-action="Create"
                       asp-route-productoId="@Model.Id"
                       class="btn btn-glassflow w-100 mt-4">

                    <i class="bi bi-file-earmark-plus me-1"></i>

                    Solicitar cotización

                </a>
            }

        </div>

    </div>

</div>