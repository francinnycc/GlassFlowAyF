@model GlassFlowAyF.Models.VisitaTecnica

@{
    ViewData["Title"] = "Programar visita";
}

<div class="page-header">

    <div>
        <h1>Programar visita técnica</h1>

        <p>
            Selecciona la solicitud,
            fecha y técnico responsable.
        </p>
    </div>

</div>

<form asp-action="Create"
      method="post"
      class="glass-card">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <div class="row g-3">

        <div class="col-12">

            <label asp-for="SolicitudCotizacionId"
                   class="form-label">
            </label>

            <select asp-for="SolicitudCotizacionId"
                    asp-items="ViewBag.Solicitudes"
                    class="form-select">

                <option value="">
                    Seleccione una solicitud
                </option>

            </select>

        </div>

        <div class="col-md-6">

            <label asp-for="FechaHora"
                   class="form-label">
            </label>

            <input asp-for="FechaHora"
               type="datetime-local"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               step="60"
               class="form-control" />

        <span asp-validation-for="FechaHora"
              class="text-danger"></span>

        </div>

        <div class="col-md-6">
            <label asp-for="TecnicoAsignado" class="form-label"></label>

            <select asp-for="TecnicoAsignado" class="form-select">
                <option value="">Seleccione un técnico</option>

                @if (ViewBag.Tecnicos != null)
                {
                    @foreach (var tecnico in ViewBag.Tecnicos)
                    {
                        <option value="@tecnico.NombreCompleto">
                            @tecnico.NombreCompleto
                        </option>
                    }
                }
            </select>

            <span asp-validation-for="TecnicoAsignado"
                  class="text-danger"></span>
        </div>

        <div class="col-12">

            <label asp-for="Direccion"
                   class="form-label">
            </label>

            <input asp-for="Direccion"
                   class="form-control" />

        </div>

        <div class="col-12">

            <label asp-for="Observaciones"
                   class="form-label">
            </label>

            <textarea asp-for="Observaciones"
                      class="form-control"
                          rows="3">
            </textarea>

            </div>

        </div>

        <div class="mt-4">

            <button class="btn btn-glassflow">
                Guardar visita
            </button>

        </div>

    </form>