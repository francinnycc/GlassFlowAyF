@model GlassFlowAyF.Extensions.PagedResult<GlassFlowAyF.Models.VisitaTecnica>

@{
    ViewData["Title"] = "Visitas técnicas";
}

<div class="page-header">

    <div>
        <h1>Agenda de visitas técnicas</h1>

        <p>
            Organiza mediciones y
            revisiones presenciales.
        </p>
    </div>

    <a class="btn btn-glassflow"
       asp-action="Create">

        Programar visita

    </a>

</div>


<div class="row g-4">

    @foreach (var visita in Model.Items)
    {
        <div class="col-md-6 col-xl-4">

            <div class="glass-card h-100">

                <span class="status-badge">
                    @visita.Estado
                </span>

                <h4 class="mt-3">
                    @visita.FechaHora.ToString("dd/MM/yyyy")
                </h4>

                <p>
                    @visita.FechaHora.ToString("hh:mm tt")
                </p>

                <p>
                    <strong>Técnico:</strong>
                    @visita.TecnicoAsignado
                </p>

                <p>
                    <strong>Cliente:</strong>
                    @(visita.SolicitudCotizacion?.NombreCliente
                        ?? "Sin cliente")
                </p>

                <p class="text-muted">
                    @visita.Direccion
                </p>

                <div class="mt-3">

                    @if (!visita.VisitaCompletada)
                    {
                        <a asp-action="Resultado"
                           asp-route-id="@visita.Id"
                           class="btn btn-outline-primary w-100">

                            <i class="bi bi-clipboard-check me-1"></i>

                            Registrar resultado

                        </a>
                    }
                    else
                    {
                        <span class="text-success">

                            <i class="bi bi-check-circle me-1"></i>

                            Visita completada

                        </span>
                    }

                </div>

            </div>

        </div>
    }

</div>


@if (Model.TotalPages > 1)
{
    <nav class="mt-4"
         aria-label="Paginación de visitas técnicas">

        <ul class="pagination justify-content-center">

            @if (Model.HasPreviousPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@(Model.PageIndex - 1)">

                        Anterior

                    </a>

                </li>
            }
            else
            {
                <li class="page-item disabled">

                    <span class="page-link">
                        Anterior
                    </span>

                </li>
            }


            @for (
                int i = 1;
                i <= Model.TotalPages;
                i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@i">

                        @i

                    </a>

                </li>
            }


            @if (Model.HasNextPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pagina="@(Model.PageIndex + 1)">

                        Siguiente

                    </a>

                </li>
            }
            else
            {
                <li class="page-item disabled">

                    <span class="page-link">
                        Siguiente
                    </span>

                </li>
            }

        </ul>

    </nav>
}